version "1.0"

use module "standard" version "1.0"

flow "hello" {
  systems {
    system "standard" {
      type: standard
    }
  }

  steps {
    standard.execute standard {
      operation: "describe"
      capability: "flow.example.hello"
      description: "Preserve a minimal semantic example without runtime command execution"
    } -> result {
      expect {
        ok == true
      }
    }
  }
}
