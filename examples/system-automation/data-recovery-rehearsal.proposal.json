{
  "formatVersion": 1,
  "providerId": "manual-system-automation-example",
  "request": {
    "userText": "Rehearse a database migration without changing production. Back up orders-production to retained-vault. After manual approval restore orders-rehearsal from that backup, verify the restored state, then apply migration v42 to orders-rehearsal retaining the original backup reference. Verify the migrated schema. Do not restore or migrate orders-production. Do not build or deploy an application.",
    "context": {},
    "mode": "DRAFT"
  },
  "response": {
    "normalizedIntent": {
      "intentVersion": "2.0",
      "kind": "FlowIntentDocument",
      "name": "data-recovery-rehearsal",
      "workflows": [
        {
          "name": "main",
          "kind": "RESTORE",
          "steps": [
            {
              "id": "backup",
              "capability": "BACKUP",
              "params": {
                "subject": "orders-production",
                "destination": "retained-vault",
                "retention": "P30D"
              },
              "requires": [],
              "produces": [
                "backup_point"
              ]
            },
            {
              "id": "approval",
              "capability": "APPROVE",
              "params": {
                "message": "Approve isolated recovery rehearsal"
              },
              "requires": [
                "backup"
              ],
              "produces": []
            },
            {
              "id": "restore",
              "capability": "RESTORE",
              "params": {
                "subject": "orders-rehearsal",
                "recoveryPoint": "ref:backup_point"
              },
              "requires": [
                "approval",
                "backup"
              ],
              "produces": [
                "restored_state"
              ]
            },
            {
              "id": "verify-restore",
              "capability": "VERIFY",
              "params": {
                "resource": "orders-rehearsal",
                "criteria": "ref:restored_state"
              },
              "requires": [
                "restore"
              ],
              "produces": [
                "restore_check"
              ]
            },
            {
              "id": "migrate",
              "capability": "DATABASE_MIGRATE",
              "params": {
                "database": "orders-rehearsal",
                "migration": "v42",
                "backup": "ref:backup_point"
              },
              "requires": [
                "verify-restore",
                "backup"
              ],
              "produces": [
                "migrated_state"
              ]
            },
            {
              "id": "verify-schema",
              "capability": "VERIFY",
              "params": {
                "resource": "orders-rehearsal-schema",
                "criteria": "ref:migrated_state"
              },
              "requires": [
                "migrate"
              ],
              "produces": []
            }
          ]
        }
      ],
      "failure": {
        "notify": false,
        "rollback": false,
        "stopOnError": true
      }
    },
    "report": {
