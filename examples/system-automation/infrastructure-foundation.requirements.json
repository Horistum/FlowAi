{
  "formatVersion": 2,
  "request": {
    "userText": "Prepare an Azure development foundation after policy check and manual approval. Create dev-network, dev-identity, dev-compute, dev-monitoring, dev-project, dev-connection and dev-agents. The compute configuration must consume the new network and identity outputs. Monitoring must consume compute state. The service connection must consume the project and identity outputs. Agents must consume compute and connection outputs. Verify dev-foundation using the monitoring and agents outputs. Do not create shared-network. Do not check out source, build or deploy an application.",
    "context": {
      "knownSystems": {
        "cloud": "Azure development account; implementation selection remains open",
        "devops": "DevOps organization to be selected by the operator"
      }
    },
    "mode": "DRAFT"
  },
  "origin": "REVIEWER_AUTHORED",
  "confirmation": "CONFIRMED",
  "reviewerId": "repository-example-reviewer",
  "requirements": [
    {
      "id": "all-provisions",
      "sourceQuote": "Create dev-network, dev-identity, dev-compute, dev-monitoring, dev-project, dev-connection and dev-agents.",
      "check": {
        "kind": "capability-count",
        "selector": {
          "capability": "PROVISION",
          "parameters": {}
        },
        "minimum": 7,
        "maximum": 7
      }
    },
    {
