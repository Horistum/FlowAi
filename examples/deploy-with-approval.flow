version "1.0"

use module "git" version "1.0"
use module "shell" version "1.0"
use module "docker" version "1.0"
use module "kubernetes" version "1.0"
use module "notify" version "1.0"

flow "deploy-with-approval" {
  input {
    app: text required
    environment: option ["dev", "test", "prod"] required
    version: text required
  }

  vars {
    imageName: "${app}:${version}"
    namespace: "${app}-${environment}"
  }

  systems {
    system "local" {
      type: shell
    }

    system "registry" {
      type: docker
      url: secret("REGISTRY_URL")
    }

    system "cluster" {
      type: kubernetes
      context: environment
    }

    system "mailer" {
      type: notify
      channel: email
    }
  }

  steps {
    shell.run local {
      command: "mvn test"
    } -> tests {
      expect {
        ok == true
        code == 0
      }
    }

    docker.build registry {
      image: imageName
      path: "."
    } -> image

    if environment == "prod" {
      approve manual {
        message: "Deploy ${app} ${version} to production?"
        timeout: "1h"
      } -> approval
    }

    kubernetes.deploy cluster {
      app: app
      namespace: namespace
      image: image.tag
    } -> deployResult {
      expect {
        ok == true
      }
    }

    notify.send mailer {
      subject: "Deployment finished"
      body: "${app} ${version} deployed to ${environment}"
    }
  }

  on error {
    notify.send mailer {
      subject: "Deployment failed"
      body: error.message
    }
  }
}
