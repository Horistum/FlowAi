{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowlang.dev/schemas/target-registry/2.0/target-registry.schema.json",
  "title": "Flow Target Registry v2.0",
  "type": "object",
  "required": ["kind", "version", "expressionProfiles", "targets"],
  "properties": {
    "kind": { "const": "FlowTargetRegistry" },
    "version": { "const": "2.0" },
    "description": { "type": "string" },
    "expressionProfiles": { "type":"array" },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "capabilities", "expressionProfile", "projectionRules"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "expressionProfile": { "type":"string", "minLength":1 },
          "capabilities": { "$ref":"#/$defs/supportMap" },
          "features": { "$ref":"#/$defs/supportMap" },
          "notes": { "type":"array", "items":{"type":"string"} },
          "projectionRules": { "type":"array", "items":{"$ref":"#/$defs/projectionRule"} }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "supportMap": { "type":"object", "additionalProperties":{"enum":["supported","full","partial","unsupported","none","requires_runtime"]} },
    "projectionRule": {
      "type":"object", "required":["module","action","mode","reason","evidenceReference"],
      "properties": {
        "module":{"type":"string","minLength":1}, "action":{"type":"string","minLength":1},
        "mode":{"enum":["native","notes_projected","adapter_required","unsupported","blocked"]},
        "reason":{"type":"string","minLength":1}, "evidenceReference":{"type":"string","minLength":1},
        "payload":{"$ref":"#/$defs/payload"}
      },
      "allOf":[
        {"if":{"properties":{"mode":{"const":"native"}}},"then":{"required":["payload"]}},
        {"if":{"properties":{"mode":{"not":{"const":"native"}}}},"then":{"not":{"required":["payload"]}}}
      ],
      "additionalProperties": false
    },
    "payload": {
      "type":"object", "required":["kind","reference"],
      "properties": { "kind":{"enum":["jenkins-step","github-action","tekton-task"]}, "reference":{"type":"string","minLength":1}, "parameters":{"type":"object","additionalProperties":{"type":"string"}} },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
