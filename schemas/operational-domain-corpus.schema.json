{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow Operational Domain Corpus Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "status", "name", "scope", "sources", "schemas", "casePackages", "counts", "invariants"],
  "properties": {
    "kind": {"const": "FlowOperationalDomainCorpus"},
    "version": {"const": "1.0"},
    "status": {"const": "executable-baseline"},
    "name": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains", "requiredCapabilities", "primaryUse", "predecessor"],
      "properties": {
        "domains": {"const": ["data-protection"]},
        "requiredCapabilities": {"const": ["BACKUP", "RESTORE"]},
        "primaryUse": {"type": "string", "minLength": 1},
        "predecessor": {"const": "AR0.1"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "platform", "sourceKind", "admission", "repository", "revision", "path", "license", "semanticLoad"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "platform": {"type": "string", "minLength": 1},
          "sourceKind": {"enum": ["production-workflow", "official-example", "official-semantic-reference"]},
          "admission": {"const": "admitted"},
          "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "path": {"type": "string", "minLength": 1},
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "spdx", "evidence"],
            "properties": {
              "status": {"const": "verified"},
              "spdx": {"type": "string", "minLength": 1},
              "evidence": {"type": "string", "minLength": 1}
            }
          },
          "semanticLoad": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "case", "provenance", "expectedPlan", "targetAssessments", "evidence", "mutation"],
      "properties": {
        "manifest": {"type": "string"},
        "case": {"type": "string"},
        "provenance": {"type": "string"},
        "expectedPlan": {"type": "string"},
        "targetAssessments": {"type": "string"},
        "evidence": {"type": "string"},
        "mutation": {"type": "string"}
      }
    },
    "casePackages": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "executableCases", "mutationCases"],
      "properties": {
        "sources": {"type": "integer", "minimum": 1},
        "executableCases": {"type": "integer", "minimum": 1},
        "mutationCases": {"type": "integer", "minimum": 1}
      }
    },
    "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
