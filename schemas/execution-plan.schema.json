{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowlang.dev/schemas/execution-plan/2.0/execution-plan.schema.json",
  "title": "Flow Execution Plan v2.0",
  "description": "Public, target-neutral execution contract produced after intent/AST validation and before target-specific rendering.",
  "type": "object",
  "required": [
    "flowName",
    "planVersion",
    "nodes"
  ],
  "properties": {
    "flowName": {
      "type": "string",
      "minLength": 1
    },
    "planVersion": {
      "const": "2.0"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "targetHints": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trigger"
      }
    },
    "dependencyRelations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependencyRelation"
      }
    },
    "controlRequirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/controlRequirement"
      }
    },
    "controlEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/controlEvidence"
      }
    },
    "controlDecision": {
      "$ref": "#/$defs/controlDecision"
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "defaultValue": {
          "type": [
            "string",
            "null"
          ]
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "sourceNodeId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "required": [
        "id",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "task",
            "approval",
            "condition",
            "parallel",
            "retry",
            "rollback",
            "notification",
            "artifact",
            "secret",
            "loop",
            "match",
            "try",
            "transform",
            "validate",
            "aggregate",
            "fail",
            "skip",
            "set",
            "expect",
            "Task",
            "Approval",
            "Condition",
            "ParallelGroup",
            "Retry",
            "Loop",
            "Match",
            "Try",
            "Transform",
            "Validate",
            "Aggregate",
            "Fail",
            "Skip",
            "Set",
            "Expect"
          ]
        },
        "module": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "resultName": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "semanticCapability": {
          "type": [
            "string",
            "null"
          ]
        },
        "effectModel": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticEffect"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "safety": {
          "type": [
            "string",
            "null"
          ]
        },
        "destructive": {
          "type": "boolean"
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targetHints": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "then": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "otherwise": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "branches": {
          "type": "array"
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "errorHandler": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "additionalProperties": true
    },
    "trigger": {
      "type": "object",
      "required": [
        "id",
        "type",
        "workflows",
        "requiredCapabilities"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "MANUAL",
            "SCHEDULE",
            "EVENT",
            "WEBHOOK"
          ]
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schedule": {
          "type": [
            "object",
            "null"
          ]
        },
        "event": {
          "type": [
            "string",
            "null"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "dependencyRelation": {
      "type": "object",
      "required": [
        "targetNodeId",
        "kind",
        "evidence",
        "resolution",
        "path",
        "candidates"
      ],
      "properties": {
        "sourceNodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetNodeId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "ORDERING",
            "VALUE",
            "WORKSPACE",
            "STATE"
          ]
        },
        "channel": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "enum": [
            "DECLARED_ORDERING",
            "DATA_REFERENCE",
            "MODULE_CONTRACT"
          ]
        },
        "resolution": {
          "enum": [
            "RESOLVED",
            "UNRESOLVED",
            "AMBIGUOUS"
          ]
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceReference": {
          "type": [
            "string",
            "null"
          ]
        },
        "continuity": {
          "type": "boolean"
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "stateTransition": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "enum": [
            "UNKNOWN",
            "ABSENT",
            "PRESENT"
          ]
        },
        "to": {
          "enum": [
            "UNKNOWN",
            "ABSENT",
            "PRESENT"
          ]
        }
      },
      "additionalProperties": false
    },
    "semanticEffect": {
      "type": "object",
      "required": [
        "domain",
        "operation",
        "resource",
        "external"
      ],
      "properties": {
        "domain": {
          "enum": [
            "SOFTWARE_DELIVERY",
            "DATA_TRANSFORMATION",
            "INFRASTRUCTURE_STATE",
            "COMMUNICATION",
            "UNKNOWN"
          ]
        },
        "operation": {
          "enum": [
            "READ",
            "CREATE",
            "UPDATE",
            "DELETE",
            "UPSERT",
            "EXECUTE",
            "EMIT",
            "UNKNOWN"
          ]
        },
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "transition": {
          "oneOf": [
            {
              "$ref": "#/$defs/stateTransition"
            },
            {
              "type": "null"
            }
          ]
        },
        "external": {
          "type": "boolean"
        },
        "sourceCapability": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "controlRequirement": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "subject",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "APPROVAL",
            "DRY_RUN",
            "BACKUP",
            "ROLLBACK_PLAN",
            "CHANGE_TICKET",
            "RETENTION_GUARD",
            "CLARIFICATION",
            "RISK_MITIGATION",
            "SAFETY_GUARD",
            "EXTERNAL_EFFECT_REVIEW",
            "POLICY_EVALUATION"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "CANONICAL_CAPABILITY",
            "INTENT_POLICY",
            "MODULE_CONTRACT",
            "ENVIRONMENT_POLICY",
            "FLOW_SOURCE"
          ]
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "controlEvidence": {
      "type": "object",
      "required": [
        "requirementId",
        "status",
        "source",
        "enforcementCapabilities"
      ],
      "properties": {
        "requirementId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "SATISFIED",
            "UNSATISFIED",
            "UNKNOWN",
            "DYNAMIC"
          ]
        },
        "source": {
          "enum": [
            "AUTHORED_STEP",
            "AUTHORED_PARAMETER",
            "AUTHORED_POLICY",
            "AUTHORED_FAILURE_POLICY",
            "AST_SAFETY_DECLARATION",
            "MODULE_CONTRACT",
            "DYNAMIC_CONDITION",
            "MISSING"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "enforcementCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "controlDecision": {
      "type": "object",
      "required": [
        "status",
        "blockingRequirementIds",
        "pendingRequirementIds"
      ],
      "properties": {
        "status": {
          "enum": [
            "ALLOWED",
            "BLOCKED",
            "PENDING"
          ]
        },
        "blockingRequirementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pendingRequirementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
