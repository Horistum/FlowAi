{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowlang.dev/schemas/execution-plan/2.0/execution-plan.schema.json",
  "title": "Flow Execution Plan v2.0",
  "description": "Public, target-neutral execution contract produced after intent/AST validation and before target-specific rendering.",
  "type": "object",
  "required": [
    "flowName",
    "planVersion",
    "nodes"
  ],
  "properties": {
    "flowName": {
      "type": "string",
      "minLength": 1
    },
    "planVersion": {
      "const": "2.0"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "targetHints": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trigger"
      }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "defaultValue": {
          "type": [
            "string",
            "null"
          ]
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "sourceNodeId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "required": [
        "id",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "task",
            "approval",
            "condition",
            "parallel",
            "retry",
            "rollback",
            "notification",
            "artifact",
            "secret",
            "loop",
            "match",
            "try",
            "transform",
            "validate",
            "aggregate",
            "fail",
            "skip",
            "set",
            "expect",
            "Task",
            "Approval",
            "Condition",
            "ParallelGroup",
            "Retry",
            "Loop",
            "Match",
            "Try",
            "Transform",
            "Validate",
            "Aggregate",
            "Fail",
            "Skip",
            "Set",
            "Expect"
          ]
        },
        "module": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "resultName": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "safety": {
          "type": [
            "string",
            "null"
          ]
        },
        "destructive": {
          "type": "boolean"
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targetHints": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "then": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "otherwise": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "branches": {
          "type": "array"
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "errorHandler": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "additionalProperties": true
    },
    "trigger": {
      "type": "object",
      "required": [
        "id",
        "type",
        "workflows",
        "requiredCapabilities"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "MANUAL",
            "SCHEDULE",
            "EVENT",
            "WEBHOOK"
          ]
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schedule": {
          "type": [
            "object",
            "null"
          ]
        },
        "event": {
          "type": [
            "string",
            "null"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
