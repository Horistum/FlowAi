{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowlang.dev/schemas/execution-plan/2.4/execution-plan.schema.json",
  "title": "Flow Execution Plan v2.4",
  "description": "Public, target-neutral execution contract produced after intent/AST validation and before target-specific rendering.",
  "type": "object",
  "required": [
    "flowName",
    "planVersion",
    "nodes"
  ],
  "properties": {
    "flowName": {
      "type": "string",
      "minLength": 1
    },
    "planVersion": {
      "const": "2.4"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "targetHints": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trigger"
      }
    },
    "dependencyRelations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependencyRelation"
      }
    },
    "controlRequirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/controlRequirement"
      }
    },
    "controlEvidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/controlEvidence"
      }
    },
    "controlDecision": {
      "$ref": "#/$defs/controlDecision"
    },
    "topologyRequirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/executionTopologyRequirement"
      }
    },
    "sourceIntent": {
      "anyOf": [
        {
          "$ref": "#/$defs/intentSourceMetadata"
        },
        {
          "type": "null"
        }
      ]
    },
    "loweringReport": {
      "anyOf": [
        {
          "$ref": "#/$defs/intentLoweringReport"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "defaultValue": {
          "type": [
            "string",
            "null"
          ]
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaultExpression": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "sourceNodeId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "required": [
        "id",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "task",
            "approval",
            "condition",
            "parallel",
            "retry",
            "rollback",
            "notification",
            "artifact",
            "secret",
            "loop",
            "match",
            "try",
            "transform",
            "validate",
            "aggregate",
            "fail",
            "skip",
            "set",
            "expect"
          ]
        },
        "module": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "target": {
          "type": [
            "string",
            "null"
          ]
        },
        "resultName": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "semanticCapability": {
          "type": [
            "string",
            "null"
          ]
        },
        "effectModel": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticEffect"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "safety": {
          "type": [
            "string",
            "null"
          ]
        },
        "destructive": {
          "type": "boolean"
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targetHints": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "then": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "otherwise": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "branches": {
          "type": "array"
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "errorHandler": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "additionalProperties": true
    },
    "trigger": {
      "type": "object",
      "required": [
        "id",
        "type",
        "workflows",
        "requiredCapabilities"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "MANUAL",
            "SCHEDULE",
            "EVENT",
            "WEBHOOK"
          ]
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schedule": {
          "type": [
            "object",
            "null"
          ]
        },
        "event": {
          "type": [
            "string",
            "null"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "dependencyRelation": {
      "type": "object",
      "required": [
        "targetNodeId",
        "kind",
        "evidence",
        "resolution",
        "path",
        "candidates"
      ],
      "properties": {
        "sourceNodeId": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetNodeId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "ORDERING",
            "VALUE",
            "WORKSPACE",
            "STATE"
          ]
        },
        "channel": {
          "type": [
            "string",
            "null"
          ]
        },
        "stateLifetime": {
          "enum": [
            "WORKFLOW",
            "DURABLE"
          ]
        },
        "evidence": {
          "enum": [
            "DECLARED_ORDERING",
            "DATA_REFERENCE",
            "MODULE_CONTRACT"
          ]
        },
        "resolution": {
          "enum": [
            "RESOLVED",
            "UNRESOLVED",
            "AMBIGUOUS"
          ]
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceReference": {
          "type": [
            "string",
            "null"
          ]
        },
        "continuity": {
          "type": "boolean"
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "STATE"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "stateLifetime"
            ]
          },
          "else": {
            "not": {
              "required": [
                "stateLifetime"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "stateTransition": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "enum": [
            "UNKNOWN",
            "ABSENT",
            "PRESENT"
          ]
        },
        "to": {
          "enum": [
            "UNKNOWN",
            "ABSENT",
            "PRESENT"
          ]
        }
      },
      "additionalProperties": false
    },
    "protectedStateRecoveryEndpoint": {
      "type": "object",
      "required": [
        "kind",
        "identity"
      ],
      "properties": {
        "kind": {
          "const": "PROTECTED_STATE"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "backupDestinationRecoveryEndpoint": {
      "type": "object",
      "required": [
        "kind",
        "identity"
      ],
      "properties": {
        "kind": {
          "const": "BACKUP_DESTINATION"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "recoveryPointEndpoint": {
      "type": "object",
      "required": [
        "kind",
        "identity"
      ],
      "properties": {
        "kind": {
          "const": "RECOVERY_POINT"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "recoverySemantics": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "source"
          ],
          "properties": {
            "kind": {
              "const": "RECOVERY_POINT_CAPTURE"
            },
            "source": {
              "$ref": "#/$defs/protectedStateRecoveryEndpoint"
            },
            "target": {
              "$ref": "#/$defs/backupDestinationRecoveryEndpoint"
            },
            "retention": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "STATE_RESTORE"
            },
            "source": {
              "$ref": "#/$defs/recoveryPointEndpoint"
            },
            "target": {
              "$ref": "#/$defs/protectedStateRecoveryEndpoint"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "semanticEffect": {
      "type": "object",
      "required": [
        "domain",
        "operation",
        "resource",
        "external"
      ],
      "properties": {
        "domain": {
          "enum": [
            "SOFTWARE_DELIVERY",
            "DATA_TRANSFORMATION",
            "INFRASTRUCTURE_STATE",
            "STATE_RECOVERY",
            "COMMUNICATION",
            "UNKNOWN"
          ]
        },
        "operation": {
          "enum": [
            "READ",
            "CREATE",
            "UPDATE",
            "DELETE",
            "UPSERT",
            "EXECUTE",
            "EMIT",
            "UNKNOWN"
          ]
        },
        "resource": {
          "type": "string",
          "minLength": 1
        },
        "transition": {
          "oneOf": [
            {
              "$ref": "#/$defs/stateTransition"
            },
            {
              "type": "null"
            }
          ]
        },
        "external": {
          "type": "boolean"
        },
        "sourceCapability": {
          "type": [
            "string",
            "null"
          ]
        },
        "recovery": {
          "$ref": "#/$defs/recoverySemantics"
        }
      },
      "additionalProperties": false
    },
    "controlRequirement": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "subject",
        "source",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "APPROVAL",
            "DRY_RUN",
            "BACKUP",
            "ROLLBACK_PLAN",
            "CHANGE_TICKET",
            "RETENTION_GUARD",
            "CLARIFICATION",
            "RISK_MITIGATION",
            "SAFETY_GUARD",
            "EXTERNAL_EFFECT_REVIEW",
            "POLICY_EVALUATION"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "CANONICAL_CAPABILITY",
            "INTENT_POLICY",
            "MODULE_CONTRACT",
            "ENVIRONMENT_POLICY",
            "FLOW_SOURCE"
          ]
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "$ref": "#/$defs/controlRequirementScope"
        }
      },
      "additionalProperties": false
    },
    "controlRequirementScope": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "INTENT" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "workflow", "subjectId"],
          "properties": {
            "kind": { "const": "OPERATION" },
            "workflow": { "type": "string", "minLength": 1 },
            "subjectId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "subjectId"],
          "properties": {
            "kind": { "const": "PLAN_NODE" },
            "subjectId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "controlEvidence": {
      "type": "object",
      "required": [
        "requirementId",
        "status",
        "source",
        "enforcementCapabilities"
      ],
      "properties": {
        "requirementId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "SATISFIED",
            "UNSATISFIED",
            "UNKNOWN",
            "DYNAMIC"
          ]
        },
        "source": {
          "enum": [
            "AUTHORED_STEP",
            "AUTHORED_PARAMETER",
            "AUTHORED_POLICY",
            "AUTHORED_FAILURE_POLICY",
            "AST_SAFETY_DECLARATION",
            "MODULE_CONTRACT",
            "DYNAMIC_CONDITION",
            "MISSING"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "enforcementCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "controlDecision": {
      "type": "object",
      "required": [
        "status",
        "blockingRequirementIds",
        "pendingRequirementIds"
      ],
      "properties": {
        "status": {
          "enum": [
            "ALLOWED",
            "BLOCKED",
            "PENDING"
          ]
        },
        "blockingRequirementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pendingRequirementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "executionTopologyRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "subject",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "WORKFLOW_SCOPE",
            "BRANCH_ISOLATION",
            "ATTEMPT_ISOLATION",
            "WORKFLOW_LIFETIME",
            "SUSPEND_RESUME",
            "EPHEMERAL_WORKSPACE",
            "DURABLE_STATE",
            "VALUE_PROPAGATION",
            "WORKSPACE_PROPAGATION",
            "STATE_PROPAGATION",
            "FAILURE_PROPAGATION"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "CANONICAL_WORKFLOW",
            "CANONICAL_CAPABILITY",
            "PLAN_STRUCTURE",
            "DEPENDENCY_RELATION",
            "MODULE_CONTRACT"
          ]
        },
        "evidenceReference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "intentWorkflowMetadata": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "stepIds"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "stepIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "intentPolicyMetadata": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "intentFailureMetadata": {
      "type": "object",
      "required": [
        "notify",
        "rollback",
        "stopOnError"
      ],
      "properties": {
        "notify": {
          "type": "boolean"
        },
        "rollback": {
          "type": "boolean"
        },
        "stopOnError": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "intentSourceMetadata": {
      "type": "object",
      "required": [
        "workflows",
        "policies",
        "systems",
        "systemPurposes",
        "failure",
        "fields"
      ],
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "workflows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/intentWorkflowMetadata"
          }
        },
        "policies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/intentPolicyMetadata"
          }
        },
        "systemPurposes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "failure": {
          "$ref": "#/$defs/intentFailureMetadata"
        },
        "systems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/intentSystemMetadata"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/intentSourceField"
          }
        }
      },
      "additionalProperties": false
    },
    "intentLoweringEvidence": {
      "type": "object",
      "required": [
        "sourceIdentity",
        "sourcePath",
        "targetIdentity",
        "disposition",
        "valueKind",
        "sourceDigest",
        "targetDigest"
      ],
      "properties": {
        "sourceIdentity": {
          "type": "string",
          "minLength": 1
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "targetIdentity": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "PRESERVED",
            "TRANSFORMED"
          ]
        },
        "valueKind": {
          "type": "string",
          "minLength": 1
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "targetDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "transform": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "intentLoweringReport": {
      "type": "object",
      "required": [
        "contractVersion",
        "artifactKind",
        "evidenceDigest",
        "evidence"
      ],
      "properties": {
        "contractVersion": {
          "const": "2.1"
        },
        "artifactKind": {
          "const": "execution-plan"
        },
        "evidenceDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/intentLoweringEvidence"
          }
        }
      },
      "additionalProperties": false
    },
    "intentSystemMetadata": {
      "type": "object",
      "required": [
        "name",
        "sourceType",
        "canonicalType",
        "config"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "sourceType": {
          "type": "string"
        },
        "canonicalType": {
          "type": "string"
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "config": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "intentSourceField": {
      "type": "object",
      "required": [
        "identity",
        "sourcePath",
        "targetIdentity",
        "disposition",
        "valueKind",
        "sourceDigest",
