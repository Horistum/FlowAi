{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowlang.dev/schemas/1.0/compatibility-policy/1.0/compatibility-policy.schema.json",
  "title": "Flow Compatibility Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["standardVersion", "compatibilityPolicyVersion", "policy", "rules", "breakingChangeTriggers"],
  "properties": {
    "standardVersion": { "type": "string" },
    "compatibilityPolicyVersion": { "type": "string" },
    "policy": { "type": "string" },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "breakingChangeTriggers": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "description"],
      "properties": {
        "id": { "type": "string" },
        "severity": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}
