{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowlang.dev/schemas/intent/2.0/intent.schema.json",
  "title": "Flow Standard Intent Document v2.0",
  "type": "object",
  "required": ["intentVersion", "kind", "name", "workflows"],
  "properties": {
    "intentVersion": { "const": "2.0" },
    "kind": { "const": "FlowIntentDocument" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" } },
    "systems": { "type": "array", "items": { "$ref": "#/$defs/system" } },
    "triggers": { "type": "array", "items": { "$ref": "#/$defs/trigger" } },
    "workflows": { "type": "array", "items": { "$ref": "#/$defs/workflow" } },
    "policies": { "type": "array", "items": { "$ref": "#/$defs/policy" } },
    "failure": { "$ref": "#/$defs/failure" }
  },
  "$defs": {
    "input": { "type": "object", "required": ["name"], "properties": { "name": {"type":"string"}, "type":{"type":"string"}, "required":{"type":"boolean"}, "default":{"$ref":"#/$defs/intentValue"} }, "additionalProperties": false },
    "system": { "type":"object", "required":["name","type"], "properties": { "name":{"type":"string"}, "type":{"type":"string"}, "purpose":{"type":["string","null"]}, "config":{"type":"object","additionalProperties":{"$ref":"#/$defs/intentValue"}} }, "additionalProperties": true },
    "trigger": {
      "type":"object", "required":["id","type","workflows"],
      "properties": {
        "id":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_-]*$"},
        "type":{"enum":["MANUAL","SCHEDULE","EVENT","WEBHOOK"]},
        "workflows":{"type":"array","items":{"type":"string"},"minItems":1},
        "schedule":{"$ref":"#/$defs/schedule"},
        "event":{"type":["string","null"]},
        "params":{"type":"object","additionalProperties":{"$ref":"#/$defs/intentValue"}}
      },
      "allOf": [
        { "if":{"properties":{"type":{"const":"SCHEDULE"}}}, "then":{"required":["schedule"]} },
        { "if":{"properties":{"type":{"enum":["EVENT","WEBHOOK"]}}}, "then":{"required":["event"]} }
      ],
      "additionalProperties": false
    },
    "schedule": { "type":"object", "required":["kind","expression"], "properties": { "kind":{"enum":["CRON","INTERVAL","CALENDAR"]}, "expression":{"type":"string","minLength":1}, "timezone":{"type":["string","null"]} }, "additionalProperties": false },
    "workflow": { "type":"object", "required":["name","kind","steps"], "properties": { "name":{"type":"string"}, "kind":{"type":"string","not":{"const":"SCHEDULE"}}, "steps":{"type":"array","items":{"$ref":"#/$defs/step"}} }, "additionalProperties": false },
    "step": { "type":"object", "required":["id","capability"], "properties": { "id":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_-]*$"}, "capability":{"type":"string","not":{"const":"SCHEDULE"}}, "description":{"type":["string","null"]}, "uses":{"type":["string","null"],"pattern":"^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"}, "requires":{"type":"array","items":{"type":"string"}}, "produces":{"type":"array","items":{"type":"string"}}, "params":{"type":"object","additionalProperties":{"$ref":"#/$defs/intentValue"}} }, "additionalProperties": false },
    "policy": { "type":"object", "required":["name","type"], "properties": { "name":{"type":"string"}, "type":{"type":"string"}, "condition":{"type":["string","null"]}, "message":{"type":["string","null"]} }, "additionalProperties": false },
    "intentValue": { "oneOf": [ {"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"null"},{"type":"array","items":{"$ref":"#/$defs/intentValue"}},{"type":"object","additionalProperties":{"$ref":"#/$defs/intentValue"}} ] },
    "failure": { "type":"object", "properties": { "notify":{"type":"boolean"}, "rollback":{"type":"boolean"}, "stopOnError":{"type":"boolean"} }, "additionalProperties": false }
  },
  "additionalProperties": false
}
