{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operation-outcome-review.schema.json",
  "title": "Operation Outcome Review v1",
  "description": "Syntactic interchange only. The outcome reader and reviewer own semantic validity, graph binding, authentication and freshness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "state",
    "graphDigest",
    "runId",
    "evaluatedAt",
    "requirementsSource",
    "results",
    "diagnostics",
    "scope",
    "executionAuthorized",
    "workflowExecutionCorrectness",
    "observationTruth",
    "reviewerAttribution"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "const": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "SATISFIED",
        "VIOLATED",
        "UNRESOLVED"
      ]
    },
    "graphDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "compilationSource": {
      "type": "object"
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "evaluatedAt": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "minLength": 1001
          }
        }
      ]
    },
    "requirementsSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "sha256",
        "sizeBytes"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "not": {
                "minLength": 1001
              }
            }
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "observationsSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "sha256",
        "sizeBytes"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "not": {
                "minLength": 1001
              }
            }
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "trustSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "sha256",
        "sizeBytes"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "not": {
                "minLength": 1001
              }
            }
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "resource",
          "state",
          "code",
          "observationIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "nodeId": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              {
                "not": {
                  "minLength": 1001
                }
              }
            ]
          },
          "resource": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scope",
              "type",
              "key"
            ],
            "properties": {
              "scope": {
                "type": "string",
                "minLength": 1,
                "allOf": [
                  {
                    "not": {
                      "minLength": 1001
                    }
                  }
                ]
              },
              "type": {
                "type": "string",
                "minLength": 1,
                "allOf": [
                  {
                    "not": {
                      "minLength": 1001
                    }
                  }
                ]
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "allOf": [
                  {
                    "not": {
                      "minLength": 1001
                    }
                  }
                ]
              }
            }
          },
          "state": {
            "type": "string",
            "enum": [
              "SATISFIED",
              "VIOLATED",
              "UNRESOLVED"
            ]
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "observationIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
            },
            "minItems": 0,
            "allOf": [
              {
                "not": {
                  "minItems": 257
                }
              }
            ]
          }
        }
      },
      "minItems": 1,
      "allOf": [
        {
          "not": {
            "minItems": 65
          }
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
      },
      "minItems": 0,
      "allOf": [
        {
          "not": {
            "minItems": 257
          }
        }
      ]
    },
    "scope": {
      "const": "declared-operation-postconditions"
    },
    "executionAuthorized": {
      "const": false
    },
    "workflowExecutionCorrectness": {
      "const": "unassessed"
    },
    "observationTruth": {
      "const": "trusted-observer-assertion"
    },
    "reviewerAttribution": {
      "const": "caller-declared"
    }
  }
}
