{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowlang.org/schemas/intent-v3.1.schema.json",
  "title": "Structured Flow Intent 3.1",
  "type": "object",
  "required": [
    "intentVersion",
    "kind",
    "name",
    "workflows"
  ],
  "properties": {
    "intentVersion": {
      "const": "3.1"
    },
    "kind": {
      "const": "FlowIntentDocument"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "systems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system"
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trigger"
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workflow"
      },
      "minItems": 1
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/policy"
      }
    },
    "failure": {
      "$ref": "#/$defs/failure"
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "$ref": "#/$defs/intentValue"
        }
      },
      "additionalProperties": false
    },
    "system": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "config": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/intentValue"
          }
        }
      },
      "additionalProperties": true
    },
    "trigger": {
      "type": "object",
      "required": [
        "id",
        "type",
        "workflows"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "type": {
          "enum": [
            "MANUAL",
            "SCHEDULE",
            "EVENT",
            "WEBHOOK"
          ]
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "schedule": {
          "$ref": "#/$defs/schedule"
        },
        "event": {
          "type": [
            "string",
            "null"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/intentValue"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "SCHEDULE"
              }
            }
          },
          "then": {
            "required": [
              "schedule"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "EVENT",
                  "WEBHOOK"
                ]
              }
            }
          },
          "then": {
            "required": [
              "event"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "required": [
        "kind",
        "expression"
      ],
      "properties": {
        "kind": {
          "enum": [
            "CRON",
            "INTERVAL",
            "CALENDAR"
          ]
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": [
        "name",
        "kind",
        "body"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "not": {
            "const": "SCHEDULE"
          }
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statement"
          },
          "not": {
            "minItems": 2001
          }
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "intentValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/intentValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/intentValue"
          }
        }
      ]
    },
    "failure": {
      "type": "object",
      "properties": {
        "notify": {
          "type": "boolean"
        },
        "rollback": {
          "type": "boolean"
        },
        "stopOnError": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "statement": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "capability",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "capability": {
              "type": "string",
              "not": {
                "const": "SCHEDULE"
              }
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "uses": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
            },
            "requires": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "produces": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "params": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/intentValue"
              }
            },
            "kind": {
              "const": "operation"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "when",
            "then"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "kind": {
              "const": "branch"
            },
            "when": {
              "$ref": "#/$defs/intentValue"
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/statement"
              },
              "not": {
                "minItems": 2001
              }
            },
            "otherwise": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/statement"
              },
              "not": {
                "minItems": 2001
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "value"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "kind": {
              "const": "value"
            },
            "value": {
              "$ref": "#/$defs/intentValue"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "sources"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "kind": {
              "const": "merge"
            },
            "sources": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^ref:[A-Za-z_][A-Za-z0-9_]*$"
              },
              "not": {
                "minItems": 2001
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "body",
            "onFailure",
            "disposition"
          ],
          "properties": {
            "kind": {
              "const": "attempt"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "body": {
              "type": "array",
              "minItems": 1,
              "not": {
                "minItems": 2001
              },
              "items": {
                "$ref": "#/$defs/statement"
              }
            },
            "onFailure": {
              "type": "array",
              "minItems": 1,
              "not": {
                "minItems": 2001
              },
              "items": {
                "$ref": "#/$defs/statement"
              }
            },
            "disposition": {
              "enum": [
                "propagate",
                "recover"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "body",
            "maxAttempts",
            "delaySeconds"
          ],
          "properties": {
            "kind": {
              "const": "retry"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
            },
            "body": {
              "type": "array",
              "minItems": 1,
              "not": {
                "minItems": 2001
              },
              "items": {
                "$ref": "#/$defs/statement"
              }
            },
            "maxAttempts": {
              "type": "integer",
              "minimum": 1,
              "not": {
                "minimum": 101
              }
            },
            "delaySeconds": {
              "type": "integer",
              "minimum": 0,
              "not": {
                "minimum": 3601
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
