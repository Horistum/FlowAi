{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operation-precondition-trust.schema.json",
  "title": "Operation Precondition Trust v1",
  "description": "Syntactic interchange. The canonical precondition reader and reviewer own graph binding, authentication, freshness, resource semantics and cross-field constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "grants"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "const": 1
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "allOf": [
        {
          "not": {
            "minItems": 65
          }
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyId",
          "publicKey",
          "scopes",
          "resourceTypes"
        ],
        "properties": {
          "keyId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "publicKey": {
            "type": "string",
            "minLength": 1,
            "allOf": [
              {
                "not": {
                  "minLength": 257
                }
              }
            ]
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "allOf": [
              {
                "not": {
                  "minItems": 65
                }
              }
            ],
            "items": {
              "type": "string",
              "minLength": 1,
              "allOf": [
                {
                  "not": {
                    "minLength": 1001
                  }
                }
              ]
            },
            "uniqueItems": true
          },
          "resourceTypes": {
            "type": "array",
            "minItems": 1,
            "allOf": [
              {
                "not": {
                  "minItems": 65
                }
              }
            ],
            "items": {
              "type": "string",
              "minLength": 1,
              "allOf": [
                {
                  "not": {
                    "minLength": 1001
                  }
                }
              ]
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
