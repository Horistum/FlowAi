{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowlang.dev/schemas/target-semantics-matrix.schema.json",
  "title": "Flow Target Semantics Matrix",
  "type": "object",
  "required": ["standardVersion", "matrixVersion", "status", "targetIds", "entries", "portabilityRule"],
  "properties": {
    "standardVersion": { "type": "string" },
    "matrixVersion": { "const": "2.0" },
    "status": { "enum": ["PASS", "FAIL"] },
    "targetIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feature", "semanticsByTarget", "requiredDiagnosticWhenUnsupported"],
        "properties": {
          "feature": { "type": "string" },
          "semanticsByTarget": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "requiredDiagnosticWhenUnsupported": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "portabilityRule": { "type": "string" }
  },
  "additionalProperties": false
}
