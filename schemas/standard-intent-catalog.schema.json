{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowlang.dev/schemas/1.0/standard-intent-catalog.schema.json",
  "title": "Flow Standard Intent Catalog",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["capability", "category", "maturity", "description"],
    "properties": {
      "capability": { "type": "string" },
      "category": { "type": "string" },
      "maturity": { "type": "string", "enum": ["stable", "draft", "extension", "unknown"] },
      "description": { "type": "string" },
      "typicalModules": { "type": "array", "items": { "type": "string" } },
      "requiredDesignQuestions": { "type": "array", "items": { "type": "string" } },
      "notes": { "type": "array", "items": { "type": "string" } }
    }
  }
}
