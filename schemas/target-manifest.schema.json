{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowlang.dev/schemas/target-manifest/3.0/target-manifest.schema.json",
  "title": "Flow Target Manifest v3.0",
  "type": "object",
  "required": ["manifestVersion", "standardVersion", "target", "flowName", "compatibility", "triggers", "jobs"],
  "properties": {
    "manifestVersion": { "const": "3.0" },
    "standardVersion": { "const": "0.8.0" },
    "target": { "type": "string", "minLength": 1 },
    "flowName": { "type": "string", "minLength": 1 },
    "compatibility": { "type": "object" },
    "inputs": { "type": "array" },
    "triggers": { "type": "array", "items": { "$ref": "#/$defs/trigger" } },
    "mappingNotes": { "type": "array", "items": { "$ref": "#/$defs/mappingNote" } },
    "jobs": { "type": "array", "items": { "$ref": "#/$defs/job" } },
    "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "$defs": {
    "trigger": {
      "type": "object",
      "required": ["id", "type", "workflows"],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["MANUAL", "SCHEDULE", "EVENT", "WEBHOOK"] },
        "workflows": { "type": "array", "items": { "type": "string" } },
        "scheduleKind": { "type": ["string", "null"] },
        "scheduleExpression": { "type": ["string", "null"] },
        "timezone": { "type": ["string", "null"] },
        "event": { "type": ["string", "null"] },
        "params": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "job": {
      "type": "object",
      "required": ["id", "steps"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "dependsOn": { "type": "array", "items": { "type": "string" } },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "mappingNotes": { "type": "array", "items": { "$ref": "#/$defs/mappingNote" } },
        "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["id", "type", "materialization"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "module": { "type": ["string", "null"] },
        "action": { "type": ["string", "null"] },
        "target": { "type": ["string", "null"] },
        "materialization": { "$ref": "#/$defs/materialization" },
        "rendererPayload": { "oneOf": [{ "$ref": "#/$defs/rendererPayload" }, { "type": "null" }] },
        "dependsOn": { "type": "array", "items": { "type": "string" } },
        "params": { "type": "object", "additionalProperties": { "type": "string" } },
        "children": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "mappingNotes": { "type": "array", "items": { "$ref": "#/$defs/mappingNote" } },
        "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "materialization": {
      "type": "object",
      "required": ["status", "capability", "reason", "requirements", "metadata"],
      "properties": {
        "status": { "enum": ["NATIVE", "NOTES_PROJECTED", "ADAPTER_REQUIRED", "DECLARATIVE_ONLY", "SEMANTIC_ONLY", "UNSUPPORTED", "BLOCKED"] },
        "capability": { "type": "string" },
        "reason": { "type": "string", "minLength": 1 },
        "requirements": { "type": "object", "additionalProperties": { "type": "string" } },
        "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "rendererPayload": {
      "type": "object",
      "required": ["kind", "target", "reference", "bindings", "evidenceReference"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+:/-]*$" },
        "target": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 },
        "bindings": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "additionalProperties": { "$ref": "#/$defs/manifestBinding" }
        },
        "evidenceReference": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "manifestBinding": {
      "oneOf": [
        { "$ref": "#/$defs/resolvedLiteral" },
        { "$ref": "#/$defs/resolvedTaskParameter" },
        { "$ref": "#/$defs/unresolvedTaskParameter" },
        { "$ref": "#/$defs/resolvedTaskInput" },
        { "$ref": "#/$defs/unresolvedTaskInput" },
        { "$ref": "#/$defs/resolvedTaskMetadata" },
        { "$ref": "#/$defs/unresolvedTaskMetadata" },
        { "$ref": "#/$defs/symbolicNamedBinding" },
        { "$ref": "#/$defs/symbolicTaskOutput" },
        { "$ref": "#/$defs/symbolicTargetExpression" }
      ]
    },
    "resolvedLiteral": {
      "type": "object",
      "required": ["kind", "value", "resolutionStatus"],
      "properties": {
        "kind": { "const": "LITERAL" },
        "value": { "type": "string" },
        "resolutionStatus": { "const": "RESOLVED" }
      },
      "additionalProperties": false
    },
    "resolvedTaskParameter": {
      "type": "object",
      "required": ["kind", "name", "value", "resolutionStatus"],
      "properties": {
        "kind": { "const": "TASK_PARAMETER" },
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "defaultValue": { "type": "string" },
        "resolutionStatus": { "const": "RESOLVED" }
      },
      "additionalProperties": false
    },
    "unresolvedTaskParameter": {
      "type": "object",
      "required": ["kind", "name", "resolutionStatus", "reason"],
      "properties": {
        "kind": { "const": "TASK_PARAMETER" },
        "name": { "type": "string", "minLength": 1 },
        "defaultValue": { "type": "string" },
        "resolutionStatus": { "const": "UNRESOLVED" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "resolvedTaskInput": {
      "type": "object",
      "required": ["kind", "name", "value", "resolutionStatus"],
      "properties": {
        "kind": { "const": "TASK_INPUT" },
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string" },
        "defaultValue": { "type": "string" },
        "resolutionStatus": { "const": "RESOLVED" }
      },
      "additionalProperties": false
    },
    "unresolvedTaskInput": {
      "type": "object",
      "required": ["kind", "name", "resolutionStatus", "reason"],
      "properties": {
        "kind": { "const": "TASK_INPUT" },
        "name": { "type": "string", "minLength": 1 },
        "defaultValue": { "type": "string" },
        "resolutionStatus": { "const": "UNRESOLVED" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "resolvedTaskMetadata": {
      "type": "object",
      "required": ["kind", "field", "value", "resolutionStatus"],
      "properties": {
        "kind": { "const": "TASK_METADATA" },
        "field": { "enum": ["ID", "TARGET"] },
        "value": { "type": "string" },
        "resolutionStatus": { "const": "RESOLVED" }
      },
      "additionalProperties": false
    },
    "unresolvedTaskMetadata": {
      "type": "object",
      "required": ["kind", "field", "resolutionStatus", "reason"],
      "properties": {
        "kind": { "const": "TASK_METADATA" },
        "field": { "enum": ["ID", "TARGET"] },
        "resolutionStatus": { "const": "UNRESOLVED" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "symbolicNamedBinding": {
      "type": "object",
      "required": ["kind", "name", "resolutionStatus"],
      "properties": {
        "kind": { "enum": ["FLOW_INPUT", "SECRET", "ARTIFACT"] },
        "name": { "type": "string", "minLength": 1 },
        "resolutionStatus": { "const": "SYMBOLIC" }
      },
      "additionalProperties": false
    },
    "symbolicTaskOutput": {
      "type": "object",
      "required": ["kind", "taskId", "output", "resolutionStatus"],
      "properties": {
        "kind": { "const": "TASK_OUTPUT" },
        "taskId": { "type": "string", "minLength": 1 },
        "output": { "type": "string", "minLength": 1 },
        "resolutionStatus": { "const": "SYMBOLIC" }
      },
      "additionalProperties": false
    },
    "symbolicTargetExpression": {
      "type": "object",
      "required": ["kind", "target", "expression", "resolutionStatus"],
      "properties": {
        "kind": { "const": "TARGET_EXPRESSION" },
        "target": { "type": "string", "minLength": 1 },
        "expression": { "type": "string", "minLength": 1 },
        "resolutionStatus": { "const": "SYMBOLIC" }
      },
      "additionalProperties": false
    },
    "mappingNote": {
      "type": "object",
      "required": ["level", "target", "nodeId", "feature", "message"],
      "properties": {
        "level": { "type": "string" },
        "target": { "type": "string" },
        "nodeId": { "type": "string" },
        "feature": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
