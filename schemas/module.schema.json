{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowlang.dev/schemas/module/1.3/module.schema.json",
  "title": "Flow Capability Module Descriptor v1.3 draft",
  "type": "object",
  "required": [
    "kind",
    "name",
    "version"
  ],
  "properties": {
    "kind": {
      "const": "FlowModule"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "systemTypes": {
      "type": "object",
      "additionalProperties": true
    },
    "actions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "targetTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "input": {
            "type": "object",
            "additionalProperties": true
          },
          "output": {
            "type": "object",
            "additionalProperties": true
          },
          "effects": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "secrets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requiredCapabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "safety": {
            "type": "object",
            "properties": {
              "destructive": {
                "type": "boolean"
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          },
          "targetImplications": {
            "$ref": "#/$defs/targetImplications"
          },
          "additionalParams": {
            "type": "boolean"
          },
          "continuity": {
            "$ref": "#/$defs/continuity"
          },
          "implements": {
            "type": "array",
            "items": {
              "enum": [
                "CHECKOUT",
                "BUILD",
                "TEST",
                "PACKAGE",
                "BUILD_IMAGE",
                "PUSH_IMAGE",
                "DEPLOY",
                "VERIFY",
                "APPROVE",
                "ROLLBACK",
                "NOTIFY",
                "SYNC",
                "DATA_SYNC",
                "DATA_TRANSFORM",
                "TRANSFORM",
                "VALIDATE",
                "BACKUP",
                "RESTORE",
                "CLEANUP",
                "PROVISION",
                "DEPROVISION",
                "DATABASE_MIGRATE",
                "CERTIFICATE_RENEW",
                "CLUSTER_MAINTENANCE",
                "RUNBOOK",
                "INCIDENT",
                "SECRET_ROTATE",
                "POLICY_CHECK",
                "RUN_COMMAND",
                "CALL_API",
                "CUSTOM"
              ]
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "targetImplications": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "support": {
            "type": "string"
          },
          "supported": {
            "type": [
              "string",
              "boolean"
            ]
          },
          "requiredCapabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "continuity": {
      "type": "object",
      "properties": {
        "provides": {
          "$ref": "#/$defs/continuityChannels"
        },
        "requires": {
          "$ref": "#/$defs/continuityChannels"
        },
        "preserves": {
          "$ref": "#/$defs/continuityChannels"
        }
      },
      "additionalProperties": false
    },
    "continuityChannels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/continuityChannel"
      },
      "uniqueItems": true
    },
    "continuityChannel": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "value",
            "workspace",
            "state"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9._-]*$"
        },
        "lifetime": {
          "enum": [
            "workflow",
            "durable"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "state"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {},
          "else": {
            "not": {
              "required": [
                "lifetime"
              ]
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}