{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operation-precondition-observation.schema.json",
  "title": "Operation Precondition Observation v1",
  "description": "Syntactic interchange. The canonical precondition reader and reviewer own graph binding, authentication, freshness, resource semantics and cross-field constraints.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "contractSha256",
    "graphDigest",
    "assessmentId",
    "challenge",
    "requirementId",
    "nodeId",
    "resource",
    "status",
    "observedAt",
    "sourceSha256",
    "sourceSizeBytes"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "contractSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "graphDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "assessmentId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "challenge": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32,128}$"
    },
    "requirementId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "minLength": 1001
          }
        }
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "type",
        "key"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "not": {
                "minLength": 1001
              }
            }
          ]
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "not": {
                "minLength": 1001
              }
            }
          ]
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "not": {
                "minLength": 1001
              }
            }
          ]
        }
      }
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "UNKNOWN"
      ]
    },
    "observedAt": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "minLength": 1001
          }
        }
      ]
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceSizeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "instanceId": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "not": {
                "minLength": 1001
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "owner": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "allOf": [
            {
              "not": {
                "minLength": 1001
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "facts": {
      "type": "object",
      "allOf": [
        {
          "not": {
            "minProperties": 33
          }
        }
      ],
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "allOf": [
              {
                "not": {
                  "minLength": 1001
                }
              }
            ]
          },
          {
            "type": "number"
          }
        ]
      }
    }
  }
}
