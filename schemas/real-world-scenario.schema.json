{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow Real-World Scenario Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "status", "resultVocabulary", "continuityVocabulary", "scenarios"],
  "properties": {
    "kind": {"const": "FlowRealWorldScenarioCatalog"},
    "version": {"type": "string"},
    "status": {"type": "string"},
    "resultVocabulary": {"type": "array", "items": {"type": "string"}},
    "continuityVocabulary": {"type": "array", "items": {"type": "string"}},
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "category", "admission", "sourceRefs", "baselineExpectation", "claim"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "category": {"enum": ["common", "production", "advanced", "negative"]},
          "admission": {"enum": ["admitted", "screened", "planned"]},
          "lifecycle": {"enum": ["CATALOGUED", "SOURCE_VERIFIED", "INTENT_RECONSTRUCTED", "FIXTURE_AUTHORED", "PLAN_VALIDATED", "TARGET_ASSESSED", "MUTATION_VALIDATED", "ACCEPTED"]},
          "casePath": {"type": "string"},
          "sourceRefs": {"type": "array", "items": {"type": "string"}},
          "baselineExpectation": {"enum": ["SUPPORTED", "SUPPORTED_WITH_BINDING", "SEMANTIC_ONLY", "BLOCKED_BY_TARGET_CAPABILITY", "AMBIGUOUS_SOURCE_INTENT", "UNSUPPORTED_DYNAMIC_CONSTRUCTION", "INVALID_SOURCE_PIPELINE"]},
          "claim": {"type": "string"}
        }
      }
    }
  }
}
