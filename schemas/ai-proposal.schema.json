{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowlang.dev/schemas/ai-proposal/1/ai-proposal.schema.json",
  "title": "External AI proposal envelope version 1",
  "type": "object",
  "required": [
    "formatVersion",
    "providerId",
    "request",
    "response"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "providerId": {
      "type": "string",
      "pattern": "\\S"
    },
    "request": {
      "type": "object",
      "required": [
        "userText"
      ],
      "properties": {
        "userText": {
          "type": "string",
          "pattern": "\\S"
        },
        "context": {
          "type": "object",
          "required": [],
          "properties": {
            "target": {
              "type": [
                "string",
                "null"
              ]
            },
            "defaultApplication": {
              "type": [
                "string",
                "null"
              ]
            },
            "defaultEnvironment": {
              "type": [
                "string",
                "null"
              ]
            },
            "repositoryUrl": {
              "type": [
                "string",
                "null"
              ]
            },
            "notificationChannel": {
              "type": [
                "string",
                "null"
              ]
            },
            "knownSystems": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "mode": {
          "enum": [
            "DRAFT",
            "STRICT",
            "EXPLAIN",
            "REPAIR"
          ]
        }
      },
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "required": [
        "normalizedIntent",
        "report"
      ],
      "properties": {
        "normalizedIntent": {
          "$ref": "intent.schema.json"
        },
        "report": {
          "type": "object",
          "required": [
            "mode",
            "classification",
            "confidence"
          ],
          "properties": {
            "standardVersion": {
              "type": "string"
            },
            "mode": {
              "enum": [
                "DRAFT",
                "STRICT",
                "EXPLAIN",
                "REPAIR"
              ]
            },
            "classification": {
              "type": "object",
              "required": [
                "type",
                "confidence"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "confidence": {
                  "type": "number"
                },
                "alternatives": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "type",
                      "confidence"
                    ],
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "confidence": {
                        "type": "number"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "confidence": {
              "type": "object",
              "required": [
                "overall",
                "intentType",
                "entities",
                "dependencies",
                "safety"
              ],
              "properties": {
                "overall": {
                  "type": "number"
                },
                "intentType": {
                  "type": "number"
                },
                "entities": {
                  "type": "number"
                },
                "dependencies": {
                  "type": "number"
                },
                "safety": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "entities": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "extractedEntities": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "missingDecisions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "field",
                  "value",
                  "reason",
                  "confidence"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "field": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "confidence": {
                    "type": "number"
                  }
                },
                "additionalProperties": false
              }
            },
            "openQuestions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "field",
                  "severity",
                  "question"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "field": {
                    "type": "string"
                  },
                  "severity": {
                    "enum": [
                      "REQUIRED",
                      "RECOMMENDED",
                      "OPTIONAL"
                    ]
                  },
                  "question": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "risks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "severity",
                  "message"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "severity": {
                    "enum": [
                      "LOW",
                      "MEDIUM",
                      "HIGH"
                    ]
                  },
                  "message": {
                    "type": "string"
                  },
                  "recommendation": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "mitigated": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            },
            "safetyGates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "targetPortability": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "scenarioSelection": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "selectedPack",
                    "reason"
                  ],
                  "properties": {
                    "selectedPack": {
                      "type": "string"
                    },
                    "matchedTriggers": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "alternativesRejected": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "type",
                          "confidence"
                        ],
                        "properties": {
                          "type": {
                            "type": "string"
                          },
                          "confidence": {
                            "type": "number"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "confidenceByArea": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "explanation": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "guardrails": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
