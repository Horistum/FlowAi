{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowlang.dev/schemas/artifact-integrity-report/1.0/artifact-integrity-report.schema.json",
  "title": "Flow Artifact Integrity Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standardVersion",
    "artifactIntegrityVersion",
    "flowName",
    "target",
    "status",
    "requiredArtifactsExpected",
    "requiredArtifactsPresent",
    "missingRequiredArtifacts",
    "artifactsWithoutSchema",
    "standardVersionObservations",
    "standardVersionMismatches",
    "diagnosticCoverageStatus",
    "issues"
  ],
  "properties": {
    "standardVersion": { "type": "string" },
    "artifactIntegrityVersion": { "type": "string" },
    "flowName": { "type": "string" },
    "target": { "type": "string" },
    "status": { "type": "string", "enum": ["PASS", "FAIL"] },
    "requiredArtifactsExpected": { "type": "array", "items": { "type": "string" } },
    "requiredArtifactsPresent": { "type": "array", "items": { "type": "string" } },
    "missingRequiredArtifacts": { "type": "array", "items": { "type": "string" } },
    "artifactsWithoutSchema": { "type": "array", "items": { "type": "string" } },
    "standardVersionObservations": {
      "type": "array",
      "items": { "$ref": "#/$defs/versionObservation" }
    },
    "standardVersionMismatches": {
      "type": "array",
      "items": { "$ref": "#/$defs/versionObservation" }
    },
    "diagnosticCoverageStatus": { "type": "string", "enum": ["PASS", "FAIL"] },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    }
  },
  "$defs": {
    "versionObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "standardVersion"],
      "properties": {
        "artifact": { "type": "string" },
        "standardVersion": { "type": "string" }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "artifact", "message"],
      "properties": {
        "code": { "type": "string" },
        "severity": { "type": "string", "enum": ["error", "warning", "info"] },
        "artifact": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
