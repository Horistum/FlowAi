{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowlang.dev/schemas/ast/1.0/ast.schema.json",
  "title": "Flow AST v1.0 draft",
  "type": "object",
  "required": ["astVersion", "sourceVersion", "kind", "imports", "flow"],
  "properties": {
    "astVersion": {"type": "string"},
    "sourceVersion": {"type": "string"},
    "kind": {"const": "FlowDocument"},
    "imports": {"type": "array"},
    "flow": {"type": "object"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
