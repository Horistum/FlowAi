{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowlang.dev/schemas/ast/2.1/ast.schema.json",
  "title": "Flow AST v2.1",
  "type": "object",
  "required": [
    "astVersion",
    "sourceVersion",
    "kind",
    "imports",
    "flow"
  ],
  "properties": {
    "astVersion": {
      "const": "2.1"
    },
    "sourceVersion": {
      "type": "string"
    },
    "kind": {
      "const": "FlowDocument"
    },
    "imports": {
      "type": "array"
    },
    "flow": {
      "type": "object",
      "required": [
        "name",
        "triggers",
        "steps"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "input": {
          "type": "array"
        },
        "vars": {
          "type": "array"
        },
        "systems": {
          "type": "array"
        },
        "triggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trigger"
          }
        },
        "steps": {
          "type": "array"
        },
        "errorHandler": {
          "type": [
            "object",
            "null"
          ]
        },
        "controlRequirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/controlRequirement"
          }
        },
        "controlEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/controlEvidence"
          }
        },
        "controlDecision": {
          "$ref": "#/$defs/controlDecision"
        },
        "topologyRequirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/executionTopologyRequirement"
          }
        }
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "trigger": {
      "type": "object",
      "required": [
        "type",
        "id",
        "triggerType",
        "workflows"
      ],
      "properties": {
        "type": {
          "const": "Trigger"
        },
        "id": {
          "type": "string"
        },
        "triggerType": {
          "enum": [
            "MANUAL",
            "SCHEDULE",
            "EVENT",
            "WEBHOOK"
          ]
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schedule": {
          "type": [
            "object",
            "null"
          ]
        },
        "event": {
          "type": [
            "string",
            "null"
          ]
        },
        "params": {
          "type": "object"
        }
      }
    },
    "controlRequirement": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "subject",
        "source",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "APPROVAL",
            "DRY_RUN",
            "BACKUP",
            "ROLLBACK_PLAN",
            "CHANGE_TICKET",
            "RETENTION_GUARD",
            "CLARIFICATION",
            "RISK_MITIGATION",
            "SAFETY_GUARD",
            "EXTERNAL_EFFECT_REVIEW",
            "POLICY_EVALUATION"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "CANONICAL_CAPABILITY",
            "INTENT_POLICY",
            "MODULE_CONTRACT",
            "ENVIRONMENT_POLICY",
            "FLOW_SOURCE"
          ]
        },
        "condition": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "$ref": "#/$defs/controlRequirementScope"
        }
      },
      "additionalProperties": false
    },
    "controlRequirementScope": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "const": "INTENT" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "workflow", "subjectId"],
          "properties": {
            "kind": { "const": "OPERATION" },
            "workflow": { "type": "string", "minLength": 1 },
            "subjectId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "subjectId"],
          "properties": {
            "kind": { "const": "PLAN_NODE" },
            "subjectId": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "controlEvidence": {
      "type": "object",
      "required": [
        "requirementId",
        "status",
        "source",
        "enforcementCapabilities"
      ],
      "properties": {
        "requirementId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "SATISFIED",
            "UNSATISFIED",
            "UNKNOWN",
            "DYNAMIC"
          ]
        },
        "source": {
          "enum": [
            "AUTHORED_STEP",
            "AUTHORED_PARAMETER",
            "AUTHORED_POLICY",
            "AUTHORED_FAILURE_POLICY",
            "AST_SAFETY_DECLARATION",
            "MODULE_CONTRACT",
            "DYNAMIC_CONDITION",
            "MISSING"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "enforcementCapabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "controlDecision": {
      "type": "object",
      "required": [
        "status",
        "blockingRequirementIds",
        "pendingRequirementIds"
      ],
      "properties": {
        "status": {
          "enum": [
            "ALLOWED",
            "BLOCKED",
            "PENDING"
          ]
        },
        "blockingRequirementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pendingRequirementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "executionTopologyRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "subject",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "WORKFLOW_SCOPE",
            "BRANCH_ISOLATION",
            "ATTEMPT_ISOLATION",
            "WORKFLOW_LIFETIME",
            "SUSPEND_RESUME",
            "EPHEMERAL_WORKSPACE",
            "DURABLE_STATE",
            "VALUE_PROPAGATION",
            "WORKSPACE_PROPAGATION",
            "STATE_PROPAGATION",
            "FAILURE_PROPAGATION"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "CANONICAL_WORKFLOW",
            "CANONICAL_CAPABILITY",
            "PLAN_STRUCTURE",
            "DEPENDENCY_RELATION",
            "MODULE_CONTRACT"
          ]
        },
        "evidenceReference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "additionalProperties": true
}
