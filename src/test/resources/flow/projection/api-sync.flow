// Projection-only fixture; not a semantic replacement for the authored example.
// Empty data-operation payloads exercise review rendering only; no mapping or validation is claimed.
version "1.0"

use module "rest" version "1.0"
use module "database" version "1.0"
use module "notify" version "1.0"

flow "sync-customers" {
  input {
    environment: option ["dev", "test", "prod"] required
  }

  systems {
    system "crm" {
      type: rest
      baseUrl: secret("CRM_URL")
      token: secret("CRM_TOKEN")
    }

    system "warehouse" {
      type: database
      engine: postgres
      url: secret("WAREHOUSE_URL")
    }

    system "mailer" {
      type: notify
      channel: email
    }
  }

  steps {
    rest.call crm {
      method: GET
      path: "/customers"
    } -> crmResponse

    transform crmResponse.json.items -> customers {}

    validate customers {}

    for customer in customers {
      database.upsert warehouse {
        table: "customers"
        key: customer.id
        values: customer
      } -> writeResult
    }

    aggregate customers -> summary {}

    notify.send mailer {
      subject: "Customer sync finished"
      body: "Total: ${summary.total}, active: ${summary.active}"
    }
  }
}
