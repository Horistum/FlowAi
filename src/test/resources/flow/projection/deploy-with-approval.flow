// Projection-only fixture; not a semantic replacement for the authored example.
version "1.0"

use module "git" version "1.0"
use module "standard" version "1.0"
use module "docker" version "1.0"
use module "kubernetes" version "1.0"
use module "notify" version "1.0"

flow "deploy-with-approval" {
  input {
    app: text required
    environment: option ["dev", "test", "prod"] required
    version: text required
  }

  systems {
    system "standard" {
      type: standard
    }

    system "registry" {
      type: docker
      url: secret("REGISTRY_URL")
    }

    system "cluster" {
      type: kubernetes
      context: environment
    }

    system "mailer" {
      type: notify
      channel: email
    }
  }

  steps {
    standard.execute standard {
      operation: "test"
      capability: "software.test"
      description: "Validate application behavior before image materialization"
      suite: "unit"
    } -> tests

    docker.build registry {
      image: "${app}:${version}"
      path: "."
    } -> image

    if environment == "prod" {
      approve manual {
        message: "Deploy ${app} ${version} to production?"
        timeout: "1h"
      } -> approval
    }

    kubernetes.deploy cluster {
      app: app
      namespace: "${app}-${environment}"
      image: image.tag
    } -> deployResult

    notify.send mailer {
      subject: "Deployment finished"
      body: "${app} ${version} deployed to ${environment}"
    }
  }

  on error {
    notify.send mailer {
      subject: "Deployment failed"
      body: error.message
    }
  }
}
