version "1.0"

use module "git" version "1.0"

flow "jenkins-retry-success-runtime" {
  systems {
    system "source" {
      type: git
    }
  }
  steps {
    retry { max: 3 delay: "0s" backoff: fixed } {
      git.checkout source {
        url: "git://127.0.0.1:9418/repository.git"
        branch: "selected"
      } -> attemptedCheckout
    }
    git.checkout source {
      url: "git://127.0.0.1:9418/repository.git"
      branch: "alternate"
    } -> afterRetry
  }
}
