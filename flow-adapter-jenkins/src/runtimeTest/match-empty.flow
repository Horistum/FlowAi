version "1.0"

use module "git" version "1.0"

flow "jenkins-match-empty-runtime" {
  systems {
    system "source" {
      type: git
    }
  }

  steps {
    match "literal-source" {
      when false {
        git.checkout source {
          url: "git://127.0.0.1:9418/repository.git"
          branch: "alternate"
        } -> unselectedCheckout
      }
      when true {
      }
      default {
        git.checkout source {
          url: "git://127.0.0.1:9418/repository.git"
          branch: "alternate"
        } -> defaultCheckout
      }
    }
    git.checkout source {
      url: "git://127.0.0.1:9418/repository.git"
      branch: "selected"
    } -> successorCheckout
  }
}
