version "1.0"

use module "git" version "1.0"

flow "jenkins-loop-order-runtime" {
  systems {
    system "source" {
      type: git
    }
  }

  steps {
    for item in ["selected", "selected", "alternate"] {
      if item == "selected" {
        git.checkout source {
          url: "git://127.0.0.1:9418/repository.git"
          branch: "selected"
        } -> selectedCheckout
      }
      if item == "alternate" {
        git.checkout source {
          url: "git://127.0.0.1:9418/repository.git"
          branch: "alternate"
        } -> alternateCheckout
      }
    }
    git.checkout source {
      url: "git://127.0.0.1:9418/repository.git"
      branch: "selected"
    } -> successorCheckout
  }
}
