version "1.0"
use module "git" version "1.0"

flow "jenkins-checkout-result-composition-runtime" {
  input { enabled: boolean default true }
  systems { system "source" { type: git } }
  steps {
    git.checkout source { url: "git://127.0.0.1:9418/repository.git" branch: "selected" } -> first
    git.checkout source { url: "git://127.0.0.1:9418/repository.git" branch: "alternate" } -> second
    if first.ok == true and enabled == true {
      git.checkout source { url: "git://127.0.0.1:9418/repository.git" branch: "selected" } -> inner
      if second.ok != false and inner.ok == true {
        git.checkout source { url: "git://127.0.0.1:9418/repository.git" branch: "alternate" }
      }
    }
    if first.ok == true { git.checkout source { url: "git://127.0.0.1:9418/repository.git" branch: "selected" } }
  }
}
