version "1.0"

use module "git" version "1.0"

flow "jenkins-condition-false-runtime" {
  input {
    enabled: boolean default false
  }

  systems {
    system "source" {
      type: git
    }
  }

  steps {
    if enabled == true {
      git.checkout source {
        url: "git://127.0.0.1:9418/repository.git"
        branch: "selected"
      } -> selectedCheckout
    }

    if enabled == false {
      git.checkout source {
        url: "git://127.0.0.1:9418/repository.git"
        branch: "alternate"
      } -> alternateCheckout
    }
  }
}
