version "1.0"

use module "git" version "1.0"

flow "jenkins-secret-condition-runtime" {
  systems {
    system "source" {
      type: git
    }
  }
  steps {
    if secret("leftToken") != null and secret("leftToken") == secret("rightToken") {
      git.checkout source {
        url: "git://127.0.0.1:9418/repository.git"
        branch: "selected"
      }
    }
  }
}
