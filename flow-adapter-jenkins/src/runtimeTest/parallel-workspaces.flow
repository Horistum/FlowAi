version "1.0"
use module "git" version "1.0"
flow "jenkins-parallel-workspaces-runtime" {
  systems { system "source" { type: git } }
  steps {
    parallel failFast false {
      branch "review" {
        approve manual { message: "Approve left branch?" }
        git.checkout source { url: "git://127.0.0.1:9418/repository.git" branch: "selected" }
      }
      branch "review" {
        approve manual { message: "Approve right branch?" }
        git.checkout source { url: "git://127.0.0.1:9418/repository.git" branch: "alternate" }
      }
    }
    git.checkout source {
      url: "git://127.0.0.1:9418/repository.git"
      branch: "selected"
    } -> afterJoin
  }
}
