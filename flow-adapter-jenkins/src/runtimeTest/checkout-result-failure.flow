version "1.0"

use module "git" version "1.0"

flow "jenkins-checkout-result-failure-runtime" {
  systems { system "source" { type: git } }
  steps {
    git.checkout source {
      url: "git://127.0.0.1:9418/repository.git"
      branch: "missing-revision"
    } -> checkoutResult
    if checkoutResult.ok == true {
      git.checkout source {
        url: "git://127.0.0.1:9418/repository.git"
        branch: "alternate"
      }
    }
  }
}
