version "1.0"

use module "git" version "1.0"

flow "jenkins-recovery-failure-runtime" {
  systems {
    system "source" {
      type: git
    }
  }

  steps {
    try {
      git.checkout source {
        url: "git://127.0.0.1:9418/repository.git"
        branch: "missing-revision"
      } -> bodyCheckout

      git.checkout source {
        url: "git://127.0.0.1:9418/repository.git"
        branch: "selected"
      } -> unreachableCheckout
    } on error {
      git.checkout source {
        url: "git://127.0.0.1:9418/repository.git"
        branch: "alternate"
      } -> handlerCheckout
    }

    git.checkout source {
      url: "git://127.0.0.1:9418/repository.git"
      branch: "selected"
    } -> continuedCheckout
  }
}
