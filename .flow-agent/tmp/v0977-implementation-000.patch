diff --git a/src/main/kotlin/org/flowlang/controls/CanonicalControlRequirementAuthority.kt b/src/main/kotlin/org/flowlang/controls/CanonicalControlRequirementAuthority.kt
new file mode 100644
index 0000000..626dd1e
--- /dev/null
+++ b/src/main/kotlin/org/flowlang/controls/CanonicalControlRequirementAuthority.kt
@@ -0,0 +1,342 @@
+package org.flowlang.controls
+
+import org.flowlang.intent.IntentBoolean
+import org.flowlang.intent.IntentDocument
+import org.flowlang.intent.IntentPolicy
+import org.flowlang.intent.IntentPolicyType
+import org.flowlang.intent.IntentStep
+import org.flowlang.intent.IntentString
+import org.flowlang.intent.IntentValidationIssue
+import org.flowlang.intent.IntentValue
+import org.flowlang.intent.PolicyCondition
+import org.flowlang.intent.SafetyRequirement
+import org.flowlang.intent.StandardCapability
+import org.flowlang.intent.asTextOrNull
+
+/** Inventory-independent authority for intent control requirements and authored evidence. */
+object CanonicalControlRequirementAuthority {
+    fun requirementsFor(intent: IntentDocument): List<ControlRequirement> {
+        val requirements = linkedMapOf<String, ControlRequirement>()
+        fun put(requirement: ControlRequirement) {
+            requirements[requirement.id] = requirement
+        }
+
+        val steps = intent.workflows.flatMap { it.steps }
+        requirementsForCapabilities(steps.map(IntentStep::capability)).forEach(::put)
+
+        intent.policies.forEach { policy ->
+            when (policy.type) {
+                IntentPolicyType.APPROVAL -> put(
+                    requirement(
+                        kind = ControlRequirementKind.APPROVAL,
+                        subject = policy.name,
+                        source = ControlRequirementSource.INTENT_POLICY,
+                        condition = policy.condition,
+                        message = policy.message
+                    )
+                )
+                IntentPolicyType.SAFETY -> put(safetyRequirement(policy))
+                IntentPolicyType.CUSTOM -> put(policyEvaluation(policy))
+                else -> Unit
+            }
+        }
+        return requirements.values.sortedBy { it.id }
+    }
+
+    fun requirementsForCapabilities(capabilities: Iterable<StandardCapability>): List<ControlRequirement> {
+        val values = capabilities.toSet()
+        return buildList {
+            if (StandardCapability.DATABASE_MIGRATE in values) {
+                add(requirement(ControlRequirementKind.BACKUP, "DATABASE_MIGRATE", ControlRequirementSource.CANONICAL_CAPABILITY))
+            }
+            if (StandardCapability.DEPROVISION in values) {
+                add(requirement(ControlRequirementKind.APPROVAL, "DEPROVISION", ControlRequirementSource.CANONICAL_CAPABILITY))
+            }
+            if (StandardCapability.CLEANUP in values) {
+                add(requirement(ControlRequirementKind.RETENTION_GUARD, "CLEANUP", ControlRequirementSource.CANONICAL_CAPABILITY))
+            }
+        }.sortedBy(ControlRequirement::id)
+    }
+
+    fun assess(intent: IntentDocument): ControlAssessment {
+        val requirements = requirementsFor(intent)
+        val evidence = requirements.map { evidenceFor(it, intent) }
+        return ControlDecisionAuthority.assessment(requirements, evidence)
+    }
+
+    fun validationIssues(
+        assessment: ControlAssessment,
+        requirementIds: Set<String>? = null
+    ): List<IntentValidationIssue> = buildList {
+        val evidenceById = assessment.evidence.associateBy(ControlEvidence::requirementId)
+        assessment.requirements
+            .filter { requirementIds == null || it.id in requirementIds }
+            .forEach { requirement ->
+            val evidence = evidenceById[requirement.id]
+            when (evidence?.status ?: ControlEvidenceStatus.UNKNOWN) {
+                ControlEvidenceStatus.SATISFIED -> Unit
+                ControlEvidenceStatus.DYNAMIC -> add(
+                    IntentValidationIssue(
+                        level = "warn",
+                        code = "CONTROL_EVIDENCE_DYNAMIC",
+                        message = "Control requirement '${requirement.id}' depends on dynamic evidence and remains pending until materialization enforcement."
+                    )
+                )
+                ControlEvidenceStatus.UNKNOWN,
+                ControlEvidenceStatus.UNSATISFIED -> add(
+                    IntentValidationIssue(
+                        level = "error",
+                        code = diagnosticCode(requirement.kind),
+                        message = diagnosticMessage(requirement, evidence)
+                    )
+                )
+            }
+        }
+    }
+
+    private fun evidenceFor(requirement: ControlRequirement, intent: IntentDocument): ControlEvidence {
+        val steps = intent.workflows.flatMap(IntentWorkflow@{ it.steps })
+        return when (requirement.kind) {
+            ControlRequirementKind.APPROVAL -> approvalEvidence(requirement, steps)
+            ControlRequirementKind.BACKUP -> capabilityOrFlagEvidence(requirement, steps, StandardCapability.BACKUP, "hasBackup")
+            ControlRequirementKind.DRY_RUN -> flagEvidence(requirement, intent, "dryRun")
+            ControlRequirementKind.ROLLBACK_PLAN -> rollbackEvidence(requirement, intent)
+            ControlRequirementKind.CHANGE_TICKET -> textEvidence(requirement, intent, "changeTicket")
+            ControlRequirementKind.RETENTION_GUARD -> retentionEvidence(requirement, intent)
+            ControlRequirementKind.CLARIFICATION,
+            ControlRequirementKind.RISK_MITIGATION,
+            ControlRequirementKind.SAFETY_GUARD,
+            ControlRequirementKind.EXTERNAL_EFFECT_REVIEW -> declaredSafetyEvidence(requirement, intent)
+            ControlRequirementKind.POLICY_EVALUATION -> customPolicyEvidence(requirement)
+        }
+    }
+
+    private fun approvalEvidence(
+        requirement: ControlRequirement,
+        steps: List<IntentStep>
+    ): ControlEvidence {
+        val approval = steps.firstOrNull { it.capability == StandardCapability.APPROVE }
+            ?: return missing(requirement, "No authored APPROVE step provides approval evidence.")
+        val condition = listOfNotNull(requirement.condition, approval.params["condition"]?.asTextOrNull())
+            .firstOrNull(String::isNotBlank)
+        return if (condition != null) {
+            ControlEvidence(
+                requirementId = requirement.id,
+                status = ControlEvidenceStatus.DYNAMIC,
+                source = ControlEvidenceSource.DYNAMIC_CONDITION,
+                detail = condition,
+                enforcementCapabilities = listOf("approval.manual", "condition.evaluate")
+            )
+        } else {
+            satisfied(requirement, ControlEvidenceSource.AUTHORED_STEP, "APPROVE step '${approval.id}'")
+        }
+    }
+
+    private fun capabilityOrFlagEvidence(
+        requirement: ControlRequirement,
+        steps: List<IntentStep>,
+        capability: StandardCapability,
+        flag: String
+    ): ControlEvidence {
+        steps.firstOrNull { it.capability == capability }?.let {
+            return satisfied(requirement, ControlEvidenceSource.AUTHORED_STEP, "${capability.name} step '${it.id}'")
+        }
+        return flagEvidence(requirement, steps, flag)
+    }
+
+    private fun flagEvidence(
+        requirement: ControlRequirement,
+        intent: IntentDocument,
+        key: String
+    ): ControlEvidence = flagEvidence(requirement, intent.workflows.flatMap { it.steps }, key)
+
+    private fun flagEvidence(
+        requirement: ControlRequirement,
+        steps: List<IntentStep>,
+        key: String
+    ): ControlEvidence {
+        val value = steps.asSequence().mapNotNull { it.params[key] }.firstOrNull()
+            ?: return missing(requirement, "No explicit '$key' evidence was authored.")
+        return when (value) {
+            is IntentBoolean -> if (value.value) {
+                satisfied(requirement, ControlEvidenceSource.AUTHORED_PARAMETER, "$key=true")
+            } else {
+                unsatisfied(requirement, "$key=false")
+            }
+            else -> {
+                val text = value.asTextOrNull().orEmpty()
+                when {
+                    text.equals("true", ignoreCase = true) -> satisfied(requirement, ControlEvidenceSource.AUTHORED_PARAMETER, "$key=true")
+                    text.equals("false", ignoreCase = true) -> unsatisfied(requirement, "$key=false")
+                    text.isNotBlank() -> dynamic(requirement, text, "policy.dynamic")
+                    else -> missing(requirement, "Authored '$key' evidence is blank.")
+                }
+            }
+        }
+    }
+
+    private fun rollbackEvidence(requirement: ControlRequirement, intent: IntentDocument): ControlEvidence {
+        val workflow = intent.workflows.firstOrNull { it.onError?.steps?.isNotEmpty() == true }
+        if (workflow != null) {
+            return satisfied(requirement, ControlEvidenceSource.AUTHORED_FAILURE_POLICY, "Workflow '${workflow.name}' declares onError steps.")
+        }
+        return textEvidence(requirement, intent, "rollbackPlan")
+    }
+
+    private fun textEvidence(
+        requirement: ControlRequirement,
+        intent: IntentDocument,
+        key: String
+    ): ControlEvidence {
+        val value = intent.workflows.asSequence()
+            .flatMap { it.steps.asSequence() }
+            .mapNotNull { it.params[key] }
+            .firstOrNull()
+            ?: return missing(requirement, "No explicit '$key' evidence was authored.")
+        val text = value.asTextOrNull().orEmpty()
+        return if (text.isNotBlank()) {
+            satisfied(requirement, ControlEvidenceSource.AUTHORED_PARAMETER, "$key=$text")
+        } else {
+            missing(requirement, "Authored '$key' evidence is blank.")
+        }
+    }
+
+    private fun retentionEvidence(requirement: ControlRequirement, intent: IntentDocument): ControlEvidence {
+        val policy = intent.policies.firstOrNull { it.type == IntentPolicyType.RETENTION }
+        if (policy != null && !policy.expression.isNullOrBlank()) {
+            return dynamic(requirement, policy.expression, "policy.retention")
+        }
+        return flagEvidence(requirement, intent, "retentionChecked")
+    }
+
+    private fun declaredSafetyEvidence(
+        requirement: ControlRequirement,
+        intent: IntentDocument
+    ): ControlEvidence {
+        val policy = intent.policies.firstOrNull {
+            it.type == IntentPolicyType.SAFETY && safetyKind(it) == requirement.kind
+        } ?: return missing(requirement, "The safety requirement was not backed by an authored safety policy.")
+        val expression = policy.expression?.trim().orEmpty()
+        return when {
+            expression.equals("true", ignoreCase = true) -> satisfied(requirement, ControlEvidenceSource.AUTHORED_POLICY, expression)
+            expression.equals("false", ignoreCase = true) -> unsatisfied(requirement, expression)
+            expression.isNotBlank() -> dynamic(requirement, expression, "policy.dynamic")
+            !policy.condition.isNullOrBlank() -> dynamic(requirement, policy.condition, "condition.evaluate")
+            else -> missing(requirement, "Safety policy '${policy.name}' contains no evaluable evidence.")
+        }
+    }
+
+    private fun customPolicyEvidence(requirement: ControlRequirement): ControlEvidence =
+        when {
+            !requirement.condition.isNullOrBlank() -> dynamic(requirement, requirement.condition, "policy.dynamic")
+            else -> missing(requirement, "Custom control policy '${requirement.subject}' contains no condition or expression.")
+        }
+
+    private fun safetyRequirement(policy: IntentPolicy): ControlRequirement {
+        val requirement = policy.requirement ?: PolicyCondition.parse(policy.condition)?.requirement
+        val kind = requirement?.toControlKind() ?: ControlRequirementKind.POLICY_EVALUATION
+        return requirement(kind, policy.name, ControlRequirementSource.INTENT_POLICY, policy.condition, policy.message)
+    }
+
+    private fun policyEvaluation(policy: IntentPolicy): ControlRequirement = requirement(
+        kind = ControlRequirementKind.POLICY_EVALUATION,
+        subject = policy.name,
+        source = ControlRequirementSource.INTENT_POLICY,
+        condition = policy.expression ?: policy.condition,
+        message = policy.message
+    )
+
+    private fun safetyKind(policy: IntentPolicy): ControlRequirementKind =
+        (policy.requirement ?: PolicyCondition.parse(policy.condition)?.requirement)?.toControlKind()
+            ?: ControlRequirementKind.POLICY_EVALUATION
+
+    private fun SafetyRequirement.toControlKind(): ControlRequirementKind = when (this) {
+        SafetyRequirement.DRY_RUN -> ControlRequirementKind.DRY_RUN
+        SafetyRequirement.BACKUP -> ControlRequirementKind.BACKUP
+        SafetyRequirement.ROLLBACK_PLAN -> ControlRequirementKind.ROLLBACK_PLAN
+        SafetyRequirement.CHANGE_TICKET -> ControlRequirementKind.CHANGE_TICKET
+        SafetyRequirement.CLARIFICATION -> ControlRequirementKind.CLARIFICATION
+        SafetyRequirement.RISK_MITIGATION -> ControlRequirementKind.RISK_MITIGATION
+        SafetyRequirement.RETENTION_POLICY -> ControlRequirementKind.RETENTION_GUARD
+    }
+
+    private fun requirement(
+        kind: ControlRequirementKind,
+        subject: String,
+        source: ControlRequirementSource,
+        condition: String? = null,
+        message: String? = null
+    ): ControlRequirement = ControlRequirement(
+        id = "${source.name.lowercase()}:${kind.name.lowercase()}:${normalize(subject)}",
+        kind = kind,
+        subject = subject,
+        source = source,
+        condition = condition?.takeIf(String::isNotBlank),
+        message = message?.takeIf(String::isNotBlank)
+    )
+
+    private fun normalize(value: String): String = value.trim().lowercase()
+        .replace(Regex("[^a-z0-9]+"), "-")
+        .trim('-')
+        .ifBlank { "control" }
+
+    private fun satisfied(
+        requirement: ControlRequirement,
+        source: ControlEvidenceSource,
+        detail: String
+    ) = ControlEvidence(requirement.id, ControlEvidenceStatus.SATISFIED, source, detail)
+
+    private fun unsatisfied(requirement: ControlRequirement, detail: String) =
+        ControlEvidence(requirement.id, ControlEvidenceStatus.UNSATISFIED, ControlEvidenceSource.AUTHORED_PARAMETER, detail)
+
+    private fun missing(requirement: ControlRequirement, detail: String) =
+        ControlEvidence(requirement.id, ControlEvidenceStatus.UNKNOWN, ControlEvidenceSource.MISSING, detail)
+
+    private fun dynamic(requirement: ControlRequirement, detail: String?, vararg capabilities: String) =
+        ControlEvidence(
+            requirement.id,
+            ControlEvidenceStatus.DYNAMIC,
+            ControlEvidenceSource.DYNAMIC_CONDITION,
+            detail,
+            capabilities.toList()
+        )
+
+    private fun diagnosticCode(kind: ControlRequirementKind): String = when (kind) {
+        ControlRequirementKind.APPROVAL -> "SAFETY_REQUIRES_APPROVAL"
+        ControlRequirementKind.BACKUP -> "SAFETY_REQUIRES_BACKUP"
+        ControlRequirementKind.DRY_RUN -> "SAFETY_REQUIRES_DRY_RUN"
+        ControlRequirementKind.ROLLBACK_PLAN -> "SAFETY_REQUIRES_ROLLBACK_PLAN"
+        ControlRequirementKind.CHANGE_TICKET -> "SAFETY_REQUIRES_CHANGE_TICKET"
+        ControlRequirementKind.RETENTION_GUARD -> "SAFETY_REQUIRES_RETENTION_POLICY"
+        ControlRequirementKind.CLARIFICATION -> "SAFETY_REQUIRES_CLARIFICATION"
+        ControlRequirementKind.RISK_MITIGATION -> "SAFETY_REQUIRES_RISK_MITIGATION"
+        ControlRequirementKind.SAFETY_GUARD,
+        ControlRequirementKind.EXTERNAL_EFFECT_REVIEW,
+        ControlRequirementKind.POLICY_EVALUATION -> "SAFETY_POLICY_EVIDENCE_UNKNOWN"
+    }
+
+    private fun diagnosticMessage(
+        requirement: ControlRequirement,
+        evidence: ControlEvidence?
+    ): String = "Control requirement '${requirement.kind}' for '${requirement.subject}' is " +
+        "${evidence?.status ?: ControlEvidenceStatus.UNKNOWN}: ${evidence?.detail ?: "no evidence was provided"}."
+}
