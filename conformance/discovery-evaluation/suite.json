{
  "formatVersion": 1,
  "id": "cross-domain-discovery-development",
  "description": "Public development portfolio: two goals over each of three complete local environment exports. Not held-out or live-system evidence.",
  "discoveryLimits": {
    "maxSteps": 12,
    "maxSourceBytes": 8192,
    "maxTotalSourceBytes": 65536,
    "maxRecords": 128,
    "maxEntries": 64
  },
  "cases": [
    {
      "id": "infrastructure-change",
      "domain": "infrastructure",
      "environment": "infrastructure-lab",
      "exposure": "public-development",
      "request": "private/infrastructure-change.request.json",
      "requirements": "private/infrastructure-change.requirements.json",
      "roots": [
        {
          "id": "workspace",
          "directory": "exposure/infrastructure",
          "scope": "Complete selected infrastructure laboratory export; metadata only, no secrets."
        }
      ]
    },
    {
      "id": "infrastructure-inspect",
      "domain": "infrastructure",
