{
  "intentVersion": "3.1",
  "kind": "FlowIntentDocument",
  "name": "credential-maintenance",
  "workflows": [
    {
      "name": "main",
      "kind": "CUSTOM",
      "body": [
        {
          "kind": "operation",
          "id": "approval",
          "capability": "APPROVE"
        },
        {
          "kind": "attempt",
          "id": "change",
          "disposition": "propagate",
          "body": [
            {
              "kind": "operation",
              "id": "rotate",
              "capability": "SECRET_ROTATE",
              "params": {
                "subject": "service-token"
              },
              "requires": [
                "approval"
              ]
            },
            {
              "kind": "retry",
              "id": "readiness",
              "maxAttempts": 4,
              "delaySeconds": 2,
              "body": [
                {
                  "kind": "operation",
                  "id": "consumers",
                  "capability": "VERIFY",
                  "params": {
                    "resource": "service-consumers",
                    "criteria": "new-token"
                  }
                }
              ]
            }
          ],
          "onFailure": [
            {
              "kind": "operation",
              "id": "inspect",
              "capability": "VERIFY",
              "params": {
                "resource": "service-consumers",
                "criteria": "diagnostic"
              }
            },
            {
              "kind": "operation",
              "id": "notify",
              "capability": "NOTIFY",
              "params": {
                "subject": "credential-failure",
                "body": "Operator review required"
              }
            }
          ]
        }
      ]
    }
  ]
}
