{
  "formatVersion": 1,
  "request": {
    "userText": "Renew api.example.invalid in namespace edge, then verify api.example.invalid. Do not rotate secrets.",
    "context": {},
    "mode": "DRAFT"
  },
  "origin": "REVIEWER_AUTHORED",
  "confirmation": "CONFIRMED",
  "reviewerId": "repository-test-oracle",
  "requirements": [
    {
      "id": "renew",
      "sourceQuote": "Renew",
      "check": {
        "kind": "capability-count",
        "selector": {
          "capability": "CERTIFICATE_RENEW"
        },
        "minimum": 1,
        "maximum": 1
      }
    },
    {
      "id": "certificate",
      "sourceQuote": "api.example.invalid",
      "check": {
        "kind": "literal-parameter",
        "selector": {
          "capability": "CERTIFICATE_RENEW"
        },
        "parameter": "certificate",
        "expected": "api.example.invalid"
      }
    },
    {
      "id": "namespace",
      "sourceQuote": "namespace edge",
      "check": {
        "kind": "literal-parameter",
        "selector": {
          "capability": "CERTIFICATE_RENEW"
        },
        "parameter": "namespace",
        "expected": "edge"
      }
    },
    {
      "id": "renew-effect",
      "sourceQuote": "Renew",
      "check": {
        "kind": "require-effect",
        "domain": "INFRASTRUCTURE_STATE",
        "operation": "UPDATE",
        "resource": "infrastructure.certificate",
        "selector": {
          "capability": "CERTIFICATE_RENEW"
        }
      }
    },
    {
      "id": "verify",
      "sourceQuote": "verify api.example.invalid",
      "check": {
        "kind": "capability-count",
        "selector": {
          "capability": "VERIFY"
        },
        "minimum": 1,
        "maximum": 1
      }
    },
    {
      "id": "verify-after",
      "sourceQuote": "then verify",
      "check": {
        "kind": "before",
        "before": {
          "capability": "CERTIFICATE_RENEW"
        },
        "after": {
          "capability": "VERIFY"
        }
      }
    },
    {
      "id": "no-secret-rotation",
      "sourceQuote": "Do not rotate secrets",
      "check": {
        "kind": "forbid-capability",
        "capability": "SECRET_ROTATE"
      }
    },
    {
      "id": "verified-resource",
      "sourceQuote": "verify api.example.invalid",
      "check": {
        "kind": "literal-parameter",
        "selector": {
          "capability": "VERIFY"
        },
        "parameter": "resource",
        "expected": "api.example.invalid"
      }
    }
  ]
}
