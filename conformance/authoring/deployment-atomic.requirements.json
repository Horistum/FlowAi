{
  "formatVersion": 1,
  "request": {
    "userText": "Deploy registry.example.invalid/payments@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa to staging in two independent clusters atomically: either both deployments commit or neither does.",
    "context": {},
    "mode": "DRAFT"
  },
  "origin": "REVIEWER_AUTHORED",
  "confirmation": "CONFIRMED",
  "reviewerId": "repository-test-oracle",
  "requirements": [
    {
      "id": "two-deployments",
      "sourceQuote": "two independent clusters",
      "check": {
        "kind": "capability-count",
        "selector": {
          "capability": "DEPLOY"
        },
        "minimum": 2,
        "maximum": 2
      }
    },
    {
      "id": "digest",
      "sourceQuote": "registry.example.invalid/payments@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "check": {
        "kind": "literal-parameter",
        "selector": {
          "capability": "DEPLOY"
        },
        "parameter": "image",
        "expected": "registry.example.invalid/payments@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      }
    },
    {
      "id": "environment",
      "sourceQuote": "to staging",
      "check": {
        "kind": "literal-parameter",
        "selector": {
          "capability": "DEPLOY"
        },
        "parameter": "environment",
        "expected": "staging"
      }
    },
    {
      "id": "atomicity",
      "sourceQuote": "either both deployments commit or neither does",
      "check": {
        "kind": "unsupported",
        "blocker": "EXTERNAL_ATOMICITY"
      }
    }
  ]
}
