{
  "intentVersion" : "2.0",
  "kind" : "FlowIntentDocument",
  "name" : "build-test-deploy",
  "description" : "High-level deployment intent. AI should produce this layer before low-level Flow.",
  "inputs" : [ {
    "name" : "environment",
    "type" : "option[dev,test,prod]",
    "required" : true
  }, {
    "name" : "version",
    "type" : "text",
    "required" : true
  } ],
  "systems" : [ {
    "name" : "source",
    "type" : "git",
    "purpose" : "Application source repository",
    "config" : { }
  }, {
    "name" : "registry",
    "type" : "dockerRegistry",
    "purpose" : "Image registry",
    "config" : { }
  }, {
    "name" : "cluster",
    "type" : "kubernetes",
    "purpose" : "Deployment target",
    "config" : { }
  }, {
    "name" : "standard",
    "type" : "standard",
    "purpose" : "Semantic build and test operations",
    "config" : { }
  } ],
  "triggers" : [ ],
  "workflows" : [ {
    "name" : "application-lifecycle",
    "kind" : "DEPLOY",
    "steps" : [ {
      "id" : "checkout",
      "capability" : "CHECKOUT",
      "uses" : "git.checkout",
      "requires" : [ ],
      "produces" : [ ],
