        "system" : {
          "value" : "source",
          "kind" : "string"
        },
        "branch" : {
          "value" : "main",
          "kind" : "string"
        }
      }
    }, {
      "id" : "test",
      "capability" : "TEST",
      "requires" : [ "checkout" ],
      "produces" : [ ],
      "params" : { }
    }, {
      "id" : "build-image",
      "capability" : "BUILD_IMAGE",
      "uses" : "docker.build",
      "requires" : [ "test" ],
      "produces" : [ ],
      "params" : {
        "system" : {
          "value" : "registry",
          "kind" : "string"
        },
        "image" : {
          "value" : "build-test-deploy:${version}",
          "kind" : "string"
        },
        "path" : {
          "value" : ".",
          "kind" : "string"
        },
        "push" : {
          "value" : false,
          "kind" : "boolean"
        }
      }
    }, {
      "id" : "approve-prod",
      "capability" : "APPROVE",
      "requires" : [ "build-image" ],
      "produces" : [ ],
      "params" : { }
    }, {
      "id" : "deploy",
      "capability" : "DEPLOY",
      "requires" : [ "approve-prod" ],
      "produces" : [ ],
      "params" : { }
    }, {
      "id" : "verify",
      "capability" : "VERIFY",
      "requires" : [ "deploy" ],
      "produces" : [ ],
      "params" : { }
    } ]
  } ],
  "policies" : [ {
    "name" : "production-approval",
    "type" : "APPROVAL",
    "message" : "Approval is required before deployment in this reference flow."
  } ],
  "failure" : {
    "notify" : true,
    "rollback" : true,
    "stopOnError" : true
  }
}
