{
  "id": "data-strategy",
  "sourceQuote": "Inspect the isolated database schema. If it is at revision 41, back up the database, migrate to revision 42 and verify at most twice with zero delay. On failure restore the captured backup and verify recovery before continuing. If it is already at revision 42, verify without backup, migration or restore. Never deprovision resources.",
  "meaning": "Choose the lifecycle obligations from the explicitly observed state.",
  "rationale": "Use the unique matching record; unknown or contradictory state requires clarification or further observation.",
  "inputs": [
    {
      "id": "revision",
      "source": {
        "root": "workspace",
        "recordPath": [
          "datasets",
          "*"
        ],
        "where": [
          {
            "path": [
              "role"
            ],
            "equals": "orders"
          }
        ],
        "valuePath": [
          "schemaRevision"
        ]
      },
      "factId": "fact:revision"
    },
    {
      "id": "isolation",
      "source": {
        "root": "workspace",
        "recordPath": [
          "datasets",
          "*"
        ],
        "where": [
          {
            "path": [
              "role"
            ],
            "equals": "orders"
          }
        ],
        "valuePath": [
          "isolation"
        ]
      },
      "factId": "fact:isolation"
    }
  ],
  "cases": [
    {
      "id": "migrate",
      "when": {
        "revision": 41,
        "isolation": "isolated"
      },
      "obligations": [
        {
          "id": "failure-scope",
          "check": {
            "kind": "failure-region",
            "protected": [
              {
                "capability": "DATABASE_MIGRATE",
                "parameters": {
                  "migration": "v42"
                }
              },
              {
                "capability": "VERIFY",
                "parameters": {
                  "criteria": "schema-v42"
                }
              }
            ],
            "handler": [
              {
                "capability": "RESTORE",
                "parameters": {}
              },
              {
                "capability": "VERIFY",
                "parameters": {
                  "criteria": "baseline"
                }
              }
            ],
            "disposition": "RECOVER"
          }
        },
        {
          "id": "readiness-retry",
          "check": {
            "kind": "retry-region",
            "operations": [
              {
                "capability": "VERIFY",
                "parameters": {
                  "criteria": "schema-v42"
                }
              }
            ],
            "maxAttempts": 2,
            "delaySeconds": 0
          }
        },
        {
          "id": "restore-backup",
          "check": {
            "kind": "value-from",
            "consumer": {
              "capability": "RESTORE"
            },
            "parameter": "recoveryPoint",
            "producer": {
              "capability": "BACKUP"
            },
            "evaluationScope": "SELECTED_OPERATIONS"
          }
        },
        {
          "id": "migrate-after-backup",
          "check": {
            "kind": "value-from",
            "consumer": {
              "capability": "DATABASE_MIGRATE"
            },
            "parameter": "backup",
            "producer": {
              "capability": "BACKUP"
            },
            "evaluationScope": "SELECTED_OPERATIONS"
          }
        }
      ]
    },
    {
      "id": "inspect",
      "when": {
        "revision": 42,
        "isolation": "isolated"
      },
      "obligations": [
        {
          "id": "no-migrate",
          "check": {
            "kind": "forbid-capability",
            "capability": "DATABASE_MIGRATE"
          }
        },
        {
          "id": "no-backup",
          "check": {
            "kind": "forbid-capability",
            "capability": "BACKUP"
          }
        },
        {
          "id": "no-restore",
          "check": {
            "kind": "forbid-capability",
            "capability": "RESTORE"
          }
        },
        {
          "id": "verification",
          "check": {
            "kind": "capability-count",
            "selector": {
              "capability": "VERIFY"
            },
            "minimum": 1,
            "maximum": 1
          }
        }
      ]
    }
  ]
}
