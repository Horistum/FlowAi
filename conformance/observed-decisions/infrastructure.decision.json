{
  "id": "infrastructure-strategy",
  "sourceQuote": "Prepare the development network. Reuse the shared network when it exists; otherwise allocate the requested new network. Check readiness at most three times with five seconds delay. On readiness failure remove only the allocation returned by successful creation and propagate failure; preserve shared networks. Do not rotate secrets.",
  "meaning": "Choose the lifecycle obligations from the explicitly observed state.",
  "rationale": "Use the unique matching record; unknown or contradictory state requires clarification or further observation.",
  "inputs": [
    {
      "id": "exists",
      "source": {
        "root": "workspace",
        "recordPath": [
          "resources",
          "*"
        ],
        "where": [
          {
            "path": [
              "role"
            ],
            "equals": "network"
          }
        ],
        "valuePath": [
          "exists"
        ]
      },
      "factId": "fact:exists"
    },
    {
      "id": "ownership",
      "source": {
        "root": "workspace",
        "recordPath": [
          "resources",
          "*"
        ],
        "where": [
          {
            "path": [
              "role"
            ],
            "equals": "network"
          }
        ],
        "valuePath": [
          "ownership"
        ]
      },
      "factId": "fact:ownership"
    }
  ],
  "cases": [
    {
      "id": "reuse",
      "when": {
        "exists": true,
        "ownership": "shared"
      },
      "obligations": [
        {
          "id": "no-create",
          "check": {
            "kind": "forbid-capability",
            "capability": "PROVISION"
          }
        },
        {
          "id": "no-delete",
          "check": {
            "kind": "forbid-capability",
            "capability": "DEPROVISION"
          }
        },
        {
          "id": "readiness",
          "check": {
            "kind": "retry-region",
            "operations": [
              {
                "capability": "VERIFY",
                "parameters": {
                  "criteria": "ready"
                }
              }
            ],
            "maxAttempts": 3,
            "delaySeconds": 5
          }
        }
      ]
    },
    {
      "id": "create",
      "when": {
        "exists": false,
        "ownership": "unallocated"
      },
      "obligations": [
        {
          "id": "verify-created",
          "check": {
            "kind": "value-from",
            "consumer": {
              "capability": "VERIFY"
            },
            "parameter": "resource",
            "producer": {
              "capability": "PROVISION"
            },
            "evaluationScope": "SELECTED_OPERATIONS"
          }
        },
        {
          "id": "delete-created",
          "check": {
            "kind": "value-from",
            "consumer": {
              "capability": "DEPROVISION"
            },
            "parameter": "target",
            "producer": {
              "capability": "PROVISION"
            },
            "evaluationScope": "SELECTED_OPERATIONS"
          }
        },
        {
          "id": "cleanup-scope",
          "check": {
            "kind": "failure-region",
            "protected": [
              {
                "capability": "VERIFY",
                "parameters": {
                  "criteria": "ready"
                }
              }
            ],
            "handler": [
              {
                "capability": "DEPROVISION"
              }
            ],
            "disposition": "PROPAGATE"
          }
        },
        {
          "id": "readiness",
          "check": {
            "kind": "retry-region",
            "operations": [
              {
                "capability": "VERIFY",
                "parameters": {
                  "criteria": "ready"
                }
              }
            ],
            "maxAttempts": 3,
            "delaySeconds": 5
          }
        }
      ]
    }
  ]
}
